<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Respyr Clinic — Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
  :root {
    /* Respyr brand */
    --primary: #3BB5E8;
    --primary-dark: #1E9FD0;
    --primary-light: #EBF7FC;
    --primary-soft: #F5FBFD;

    /* Neutrals */
    --bg: #FAFBFC;
    --card: #FFFFFF;
    --border: #EAEEF2;
    --border-strong: #D6DDE3;
    --text: #0F1729;
    --text-2: #4B5563;
    --text-3: #9CA3AF;
    --text-4: #C7CED6;

    /* Status */
    --good: #10B981;
    --good-bg: #ECFDF5;
    --fair: #F59E0B;
    --fair-bg: #FFFBEB;
    --poor: #EF4444;
    --poor-bg: #FEF2F2;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(15, 23, 41, 0.04);
    --shadow: 0 2px 8px rgba(15, 23, 41, 0.04), 0 0 1px rgba(15, 23, 41, 0.06);
    --shadow-lg: 0 12px 32px -8px rgba(15, 23, 41, 0.12), 0 2px 6px rgba(15, 23, 41, 0.04);

    --radius: 14px;
    --radius-sm: 10px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'cv11', 'ss01';
  }

  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input { font-family: inherit; }

  /* ========= LAYOUT ========= */
  .app { display: flex; min-height: 100vh; }

  /* Sidebar */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    background: var(--card);
    border-right: 1px solid var(--border);
    padding: 24px 16px;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    margin-bottom: 32px;
  }
  .brand-logo {
    width: 28px; height: 28px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 2px 8px rgba(59, 181, 232, 0.3);
  }
  .brand-text {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .brand-pill {
    background: var(--primary);
    color: white;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.05em;
  }

  .nav { display: flex; flex-direction: column; gap: 2px; }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--text-2);
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .nav-item:hover { background: var(--bg); color: var(--text); }
  .nav-item.active {
    background: var(--primary-light);
    color: var(--primary-dark);
  }
  .nav-item.disabled {
    color: var(--text-4);
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.55;
  }
  .nav-item .icon { width: 18px; height: 18px; stroke-width: 2; }

  .sidebar-footer {
    margin-top: auto;
    padding: 16px 12px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--text-3);
  }

  /* Main */
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Top bar */
  .topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 32px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 40;
  }

  .date-picker-wrap { position: relative; }
  .date-picker-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--card);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: all 0.15s;
    min-width: 220px;
  }
  .date-picker-btn:hover { border-color: var(--primary); }
  .date-picker-btn .icon { width: 16px; height: 16px; color: var(--primary); }
  .date-picker-btn .chevron { margin-left: auto; width: 14px; height: 14px; color: var(--text-3); }
  .date-label-muted { color: var(--text-3); font-weight: 400; font-size: 12px; }

  .date-panel {
    position: absolute; top: calc(100% + 6px); left: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    padding: 8px;
    display: none;
    z-index: 50;
    min-width: 560px;
    grid-template-columns: 180px 1fr;
    gap: 0;
  }
  .date-panel.open { display: grid; }

  .date-presets {
    display: flex; flex-direction: column;
    padding: 8px;
    border-right: 1px solid var(--border);
    gap: 2px;
  }
  .date-presets .preset-label {
    font-size: 10px; font-weight: 700;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 10px 4px;
  }
  .preset {
    text-align: left;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--text-2);
    font-weight: 500;
    transition: all 0.1s;
  }
  .preset:hover { background: var(--bg); color: var(--text); }
  .preset.active { background: var(--primary-light); color: var(--primary-dark); font-weight: 600; }

  .date-custom { padding: 16px; }
  .date-custom .cal-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px;
    font-weight: 600; font-size: 14px;
  }
  .cal-nav { padding: 4px 8px; border-radius: 6px; color: var(--text-2); }
  .cal-nav:hover { background: var(--bg); }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; font-size: 12px; }
  .cal-grid .dow { text-align: center; color: var(--text-3); font-weight: 600; padding: 6px 0; font-size: 11px; }
  .cal-day {
    text-align: center; padding: 7px 0;
    border-radius: 6px; cursor: pointer;
    color: var(--text-2);
    transition: all 0.1s;
  }
  .cal-day:hover { background: var(--bg); }
  .cal-day.other { color: var(--text-4); }
  .cal-day.in-range { background: var(--primary-light); color: var(--primary-dark); border-radius: 0; }
  .cal-day.range-start { background: var(--primary); color: white; border-radius: 6px 0 0 6px; }
  .cal-day.range-end { background: var(--primary); color: white; border-radius: 0 6px 6px 0; }
  .cal-day.today { font-weight: 700; color: var(--primary-dark); }

  .date-apply-row {
    display: flex; justify-content: flex-end; gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    grid-column: 1 / -1;
  }
  .btn-sm { padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; }
  .btn-ghost { color: var(--text-2); }
  .btn-ghost:hover { background: var(--bg); }
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-dark); }

  .search {
    flex: 1;
    max-width: 400px;
    position: relative;
  }
  .search input {
    width: 100%;
    padding: 10px 14px 10px 40px;
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 10px;
    font-size: 13px;
    color: var(--text);
    transition: all 0.15s;
  }
  .search input:focus { outline: none; border-color: var(--primary); background: white; }
  .search input::placeholder { color: var(--text-3); }
  .search .icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; color: var(--text-3);
  }

  .topbar-right { display: flex; align-items: center; gap: 16px; margin-left: auto; }
  .icon-btn {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-2);
    position: relative;
    transition: all 0.15s;
  }
  .icon-btn:hover { background: var(--bg); color: var(--text); }
  .icon-btn .dot {
    position: absolute; top: 8px; right: 10px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--poor);
    border: 2px solid var(--card);
  }

  .profile { display: flex; align-items: center; gap: 10px; }
  .avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: white;
    font-weight: 700; font-size: 15px;
    display: flex; align-items: center; justify-content: center;
  }
  .profile-info { line-height: 1.2; }
  .profile-name { font-weight: 600; font-size: 14px; }
  .profile-role { color: var(--text-3); font-size: 12px; }

  /* Content */
  .content { padding: 28px 32px; }

  .page-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 24px;
  }
  .page-title {
    font-size: 26px; font-weight: 700; letter-spacing: -0.02em;
    color: var(--text);
  }
  .page-sub {
    font-size: 13px; color: var(--text-3); margin-top: 4px;
  }
  .page-actions { display: flex; gap: 10px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 14px;
    border-radius: 10px;
    font-size: 13px; font-weight: 600;
    transition: all 0.15s;
  }
  .btn .icon { width: 15px; height: 15px; }
  .btn-outline {
    border: 1px solid var(--border-strong);
    color: var(--text-2);
    background: var(--card);
  }
  .btn-outline:hover { border-color: var(--primary); color: var(--primary-dark); }
  .btn-solid {
    background: var(--primary);
    color: white;
    box-shadow: 0 2px 8px rgba(59, 181, 232, 0.25);
  }
  .btn-solid:hover { background: var(--primary-dark); }

  /* ========= KPI ROW ========= */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .kpi {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: all 0.2s;
    animation: fadeUp 0.5s ease backwards;
  }
  .kpi:hover { border-color: var(--border-strong); transform: translateY(-1px); box-shadow: var(--shadow); }
  .kpi.clickable { cursor: pointer; }
  .kpi.clickable:hover { border-color: var(--primary); }
  .kpi.clickable:hover .kpi-drill { color: var(--primary-dark); }
  .kpi-drill {
    display: flex; align-items: center; gap: 4px;
    font-size: 11px; color: var(--text-3);
    font-weight: 600;
    transition: color 0.15s;
  }
  .kpi-drill .icon { width: 12px; height: 12px; }

  .kpi:nth-child(1) { animation-delay: 0.05s; }
  .kpi:nth-child(2) { animation-delay: 0.1s; }
  .kpi:nth-child(3) { animation-delay: 0.15s; }
  .kpi:nth-child(4) { animation-delay: 0.2s; }

  .kpi-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .kpi-label {
    font-size: 12px;
    color: var(--text-3);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .kpi-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }
  .kpi-icon .icon { width: 16px; height: 16px; }
  .kpi-icon.blue { background: var(--primary-light); color: var(--primary-dark); }
  .kpi-icon.green { background: var(--good-bg); color: var(--good); }
  .kpi-icon.amber { background: var(--fair-bg); color: var(--fair); }
  .kpi-icon.purple { background: #F3E8FF; color: #7C3AED; }
  .kpi-icon.red { background: var(--poor-bg); color: var(--poor); }

  /* Patient demographics line */
  .kpi-demographics {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    font-size: 12px;
  }
  .kpi-demographics .demo-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-weight: 600;
  }
  .kpi-demographics .demo-icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px;
    font-weight: 700;
  }
  .kpi-demographics .demo-icon.male { background: #DBEAFE; color: #1E40AF; }
  .kpi-demographics .demo-icon.female { background: #FCE7F3; color: #BE185D; }
  .kpi-demographics .demo-count { color: var(--text); font-weight: 700; font-feature-settings: 'tnum'; }
  .kpi-demographics .demo-pct { color: var(--text-3); font-weight: 500; font-size: 11px; }

  /* Concern distribution for Avg Health Score */
  .kpi-concern {
    margin-top: 12px;
  }
  .kpi-concern-bar {
    display: flex;
    height: 6px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg);
    margin-bottom: 8px;
    gap: 2px;
  }
  .kpi-concern-seg { transition: all 0.3s; border-radius: 2px; }
  .kpi-concern-seg.good { background: var(--good); }
  .kpi-concern-seg.fair { background: var(--fair); }
  .kpi-concern-seg.poor { background: var(--poor); }
  .kpi-concern-legend {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11px;
    color: var(--text-2);
  }
  .kpi-concern-legend .row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .kpi-concern-legend .row .cdot {
    width: 7px; height: 7px; border-radius: 50%;
    flex-shrink: 0;
  }
  .kpi-concern-legend .row .num {
    color: var(--text); font-weight: 700;
    font-feature-settings: 'tnum';
    min-width: 16px;
  }
  .kpi-concern-legend .row .pct {
    color: var(--text-3); font-weight: 500;
    margin-left: auto;
    font-feature-settings: 'tnum';
  }

  /* Last Sync detail rows */
  .kpi-sync-detail {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    color: var(--text-2);
  }
  .kpi-sync-detail .sync-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kpi-sync-detail .sync-dot {
    width: 7px; height: 7px; border-radius: 50%;
    flex-shrink: 0;
    animation: pulse 2.5s infinite;
  }
  .kpi-sync-detail .sync-count {
    color: var(--text);
    font-weight: 700;
    font-feature-settings: 'tnum';
  }

  .kpi-value {
    font-size: 32px; font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
    font-feature-settings: 'tnum';
  }
  .kpi-value .unit {
    font-size: 18px;
    color: var(--text-3);
    font-weight: 500;
  }
  .kpi-foot {
    display: flex; align-items: center; gap: 8px;
    margin-top: 12px;
    font-size: 12px;
    color: var(--text-3);
  }
  .trend {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 8px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 11px;
  }
  .trend.up { background: var(--good-bg); color: var(--good); }
  .trend.down { background: var(--poor-bg); color: var(--poor); }
  .trend.flat { background: var(--bg); color: var(--text-3); }
  .trend .icon { width: 11px; height: 11px; }

  .kpi-progress {
    height: 6px;
    background: var(--bg);
    border-radius: 20px;
    margin-top: 14px;
    overflow: hidden;
    position: relative;
  }
  .kpi-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
    border-radius: 20px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ========= GRID ROWS ========= */
  .grid-2-1 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .grid-1-1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }

  /* Cards */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    animation: fadeUp 0.5s ease 0.2s backwards;
  }
  .card-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .card-sub {
    font-size: 12px; color: var(--text-3); margin-top: 2px;
  }

  /* Dropdown */
  .dropdown { position: relative; display: inline-block; }
  .dropdown-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--card);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    transition: all 0.15s;
  }
  .dropdown-btn:hover { border-color: var(--primary); color: var(--text); }
  .dropdown-btn .chevron { width: 12px; height: 12px; }
  .dropdown-menu {
    position: absolute; right: 0; top: calc(100% + 4px);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    padding: 4px;
    min-width: 140px;
    z-index: 20;
    display: none;
  }
  .dropdown-menu.open { display: block; }
  .dropdown-item {
    display: block; width: 100%; text-align: left;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-2);
  }
  .dropdown-item:hover { background: var(--bg); color: var(--text); }
  .dropdown-item.active { background: var(--primary-light); color: var(--primary-dark); font-weight: 600; }

  /* Chart */
  .chart { width: 100%; height: 260px; }
  .bar-wrap {
    position: relative;
    height: 220px;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding-left: 40px;
    padding-right: 8px;
    padding-bottom: 28px;
  }
  .bar-grid {
    position: absolute; left: 40px; right: 8px; top: 0; bottom: 28px;
    display: flex; flex-direction: column; justify-content: space-between;
    pointer-events: none;
  }
  .bar-grid-line {
    border-top: 1px dashed var(--border);
    height: 0;
    position: relative;
  }
  .bar-grid-label {
    position: absolute; left: -36px; top: -8px;
    font-size: 10px; color: var(--text-3); font-weight: 500;
    width: 30px; text-align: right;
  }
  .bar {
    flex: 1;
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
    border-radius: 5px 5px 0 0;
    position: relative;
    min-height: 4px;
    cursor: pointer;
    transition: all 0.2s;
    animation: barGrow 0.8s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  }
  .bar:hover { filter: brightness(1.1); }
  .bar.inactive { background: var(--border-strong); }
  .bar-label {
    position: absolute; bottom: -22px; left: 0; right: 0;
    text-align: center;
    font-size: 10px; color: var(--text-3); font-weight: 500;
  }
  .bar-tooltip {
    position: absolute; bottom: calc(100% + 8px); left: 50%;
    transform: translateX(-50%);
    background: var(--text);
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px; font-weight: 600;
    white-space: nowrap;
    opacity: 0; pointer-events: none;
    transition: opacity 0.15s;
  }
  .bar:hover .bar-tooltip { opacity: 1; }

  /* Health Metrics */
  .metric-row {
    display: flex; flex-direction: column; gap: 18px;
  }

  /* ========= HEALTH METRICS OVERVIEW (merged card) ========= */
  .hmo-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hmo-row {
    display: grid;
    grid-template-columns: 170px 70px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 14px 10px;
    border-radius: 10px;
    transition: background 0.15s;
  }
  .hmo-row:hover { background: var(--primary-soft); }
  .hmo-metric-label {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; font-weight: 600; color: var(--text);
  }
  .hmo-metric-icon {
    width: 30px; height: 30px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .hmo-metric-icon svg { width: 15px; height: 15px; }
  .hmo-avg {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    font-feature-settings: 'tnum';
    letter-spacing: -0.01em;
  }
  .hmo-avg .unit {
    font-size: 11px;
    color: var(--text-3);
    font-weight: 500;
    margin-left: 2px;
  }
  .hmo-dist {
    display: flex;
    height: 10px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .hmo-dist-seg.good { background: var(--good); }
  .hmo-dist-seg.fair { background: var(--fair); }
  .hmo-dist-seg.poor { background: var(--poor); }
  .hmo-pills {
    display: flex;
    gap: 6px;
  }
  .hmo-pill {
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-3);
    cursor: pointer;
    transition: all 0.15s;
    font-feature-settings: 'tnum';
    min-width: 58px;
    justify-content: center;
  }
  .hmo-pill .pdot {
    width: 6px; height: 6px; border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
  .hmo-pill:not(:disabled):hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .hmo-pill.good:not(.zero) { color: var(--good); background: var(--good-bg); border-color: rgba(16, 185, 129, 0.15); }
  .hmo-pill.fair:not(.zero) { color: var(--fair); background: var(--fair-bg); border-color: rgba(245, 158, 11, 0.2); }
  .hmo-pill.poor:not(.zero) { color: var(--poor); background: var(--poor-bg); border-color: rgba(239, 68, 68, 0.2); }
  .hmo-pill.zero { color: var(--text-4); cursor: default; }
  .hmo-pill.zero:hover { transform: none; box-shadow: none; }
  .hmo-pill.active {
    box-shadow: 0 0 0 2px var(--primary);
    transform: translateY(-1px);
  }

  .hmo-separator {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 10px 10px;
    border-top: 1px solid var(--border);
    margin-top: 14px;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary-dark);
    background: var(--primary-light);
    transition: all 0.15s;
  }
  .view-all-link:hover { background: var(--primary); color: white; }
  .view-all-link .icon { stroke-width: 2.5; }

  /* ========= ADMIN ACTIONS (column, narrower) ========= */
  .admin-actions-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .admin-action {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    text-align: left;
    transition: all 0.15s;
  }
  .admin-action:hover { border-color: var(--primary); background: var(--primary-soft); }
  .admin-action .qa-icon {
    width: 34px; height: 34px;
    border-radius: 8px;
    background: var(--primary-light);
    color: var(--primary-dark);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .admin-action .qa-icon .icon { width: 16px; height: 16px; }
  .admin-action > div:not(.qa-icon) { flex: 1; min-width: 0; }
  .admin-action .qa-title { font-size: 13px; font-weight: 600; color: var(--text); }
  .admin-action .qa-sub { font-size: 11px; color: var(--text-3); line-height: 1.3; margin-top: 1px; }
  .aa-arrow { width: 14px; height: 14px; color: var(--text-3); flex-shrink: 0; }
  .admin-action:hover .aa-arrow { color: var(--primary-dark); }

  /* ========= SEGMENT DETAIL (Gender & Age click target) ========= */
  .segment-detail {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    min-height: 80px;
  }
  .segment-default {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .segment-callout .label {
    font-size: 10px;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }
  .segment-callout .value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-top: 3px;
  }
  .segment-callout.worst .value { color: var(--poor); }

  .segment-selected .seg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .segment-selected .seg-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
  }
  .segment-selected .seg-sub {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
  }
  .segment-patient {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-size: 12px;
  }
  .segment-patient + .segment-patient { border-top: 1px solid var(--border); }
  .segment-patient .sp-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary-dark);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 11px;
    flex-shrink: 0;
  }
  .segment-patient .sp-name { flex: 1; font-weight: 600; color: var(--text); }
  .segment-patient .sp-score {
    font-size: 12px;
    font-weight: 700;
    font-feature-settings: 'tnum';
  }
  .segment-patient .sp-score.good { color: var(--good); }
  .segment-patient .sp-score.fair { color: var(--fair); }
  .segment-patient .sp-score.poor { color: var(--poor); }
  .metric {
    display: flex; flex-direction: column; gap: 8px;
  }
  .metric-head {
    display: flex; align-items: center; justify-content: space-between;
  }
  .metric-name {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; color: var(--text);
  }
  .metric-icon {
    width: 24px; height: 24px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
  }
  .metric-icon .icon { width: 13px; height: 13px; }
  .metric-value {
    font-size: 13px; font-weight: 700; color: var(--text);
    font-feature-settings: 'tnum';
  }
  .metric-bar {
    display: flex;
    height: 8px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg);
  }
  .metric-seg { transition: all 0.3s; }
  .metric-seg.good { background: var(--good); }
  .metric-seg.fair { background: var(--fair); }
  .metric-seg.poor { background: var(--poor); }
  .metric-legend {
    display: flex; gap: 12px;
    font-size: 11px; color: var(--text-3);
  }
  .metric-legend span { display: inline-flex; align-items: center; gap: 4px; }
  .metric-legend .dot { width: 7px; height: 7px; border-radius: 50%; }

  /* Legend badges */
  .legend-badges {
    display: flex; gap: 10px; align-items: center;
    font-size: 11px;
  }
  .legend-badge {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--text-2);
    font-weight: 500;
  }
  .legend-dot {
    width: 8px; height: 8px; border-radius: 50%;
  }
  .legend-dot.good { background: var(--good); }
  .legend-dot.fair { background: var(--fair); }
  .legend-dot.poor { background: var(--poor); }

  /* Heatmap */
  .heatmap {
    display: grid;
    grid-template-columns: 90px repeat(4, 1fr);
    gap: 4px;
    margin-top: 6px;
  }
  .heatmap-head {
    text-align: center;
    font-size: 11px;
    color: var(--text-3);
    font-weight: 600;
    padding: 8px 0;
  }
  .heatmap-row-head {
    display: flex;
    align-items: center;
    font-size: 12px;
    color: var(--text-2);
    font-weight: 600;
    padding: 0 6px;
  }
  .heatmap-row-head .icon { width: 14px; height: 14px; margin-right: 6px; }
  .heatmap-cell {
    position: relative;
    border-radius: 8px;
    padding: 14px 6px;
    text-align: center;
    transition: all 0.2s;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .heatmap-cell:not(.empty):hover { transform: translateY(-1px); box-shadow: var(--shadow); z-index: 2; }
  .heatmap-cell.empty {
    background: repeating-linear-gradient(45deg, transparent, transparent 4px, var(--bg) 4px, var(--bg) 8px);
    border: 1px dashed var(--border);
    cursor: default;
  }
  .heatmap-cell.empty .val { color: var(--text-4); font-size: 14px; }
  .heatmap-cell.good { background: var(--good-bg); border-color: rgba(16, 185, 129, 0.15); }
  .heatmap-cell.fair { background: var(--fair-bg); border-color: rgba(245, 158, 11, 0.2); }
  .heatmap-cell.poor { background: var(--poor-bg); border-color: rgba(239, 68, 68, 0.25); }
  .heatmap-cell.active {
    box-shadow: 0 0 0 2px var(--primary), var(--shadow);
    transform: translateY(-1px);
  }
  .heatmap-cell .val {
    font-size: 15px; font-weight: 700;
    font-feature-settings: 'tnum';
  }
  .heatmap-cell.good .val { color: var(--good); }
  .heatmap-cell.fair .val { color: var(--fair); }
  .heatmap-cell.poor .val { color: var(--poor); }
  .heatmap-cell .cnt {
    font-size: 10px;
    margin-top: 2px;
    opacity: 0.75;
    font-weight: 500;
  }
  .heatmap-cell.good .cnt { color: var(--good); }
  .heatmap-cell.fair .cnt { color: var(--fair); }
  .heatmap-cell.poor .cnt { color: var(--poor); }
  .heatmap-cell.empty .cnt { color: var(--text-4); }

  /* Test log table */
  .log-list { display: flex; flex-direction: column; }
  .log-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .log-row:last-child { border-bottom: none; }
  .log-row:hover { background: var(--primary-soft); margin: 0 -12px; padding-left: 12px; padding-right: 12px; border-radius: 8px; }
  .log-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .log-meta { font-size: 11px; color: var(--text-3); margin-top: 2px; }
  .log-scores { display: flex; gap: 6px; }
  .score-pill {
    padding: 3px 8px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    font-feature-settings: 'tnum';
  }
  .score-pill.good { background: var(--good-bg); color: var(--good); }
  .score-pill.fair { background: var(--fair-bg); color: var(--fair); }
  .score-pill.poor { background: var(--poor-bg); color: var(--poor); }
  .log-time { font-size: 11px; color: var(--text-3); white-space: nowrap; }

  /* Attention list */
  .attention-list { display: flex; flex-direction: column; gap: 10px; }
  .attention-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: var(--bg);
    border-radius: 10px;
    border: 1px solid var(--border);
    transition: all 0.15s;
    cursor: pointer;
  }
  .attention-item:hover { border-color: var(--poor); background: var(--poor-bg); }
  .attention-item.dimmed { opacity: 0.35; }
  .attention-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary-dark);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px;
    flex-shrink: 0;
  }
  .attention-body { flex: 1; min-width: 0; }
  .attention-name { font-size: 13px; font-weight: 600; }
  .attention-reason { font-size: 11px; color: var(--poor); font-weight: 500; margin-top: 2px; }
  .attention-arrow { color: var(--text-3); width: 16px; height: 16px; }

  /* Attention Matrix */
  .matrix {
    display: grid;
    grid-template-columns: 110px repeat(3, 1fr);
    gap: 4px;
    margin-bottom: 16px;
  }
  .matrix-head {
    padding: 8px 4px;
    text-align: center;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .matrix-head .hdot {
    width: 8px; height: 8px; border-radius: 50%;
  }
  .matrix-head.good { color: var(--good); }
  .matrix-head.good .hdot { background: var(--good); }
  .matrix-head.fair { color: var(--fair); }
  .matrix-head.fair .hdot { background: var(--fair); }
  .matrix-head.poor { color: var(--poor); }
  .matrix-head.poor .hdot { background: var(--poor); }

  .matrix-metric {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .matrix-metric .mi {
    width: 22px; height: 22px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
  }
  .matrix-metric .mi svg { width: 12px; height: 12px; }

  .matrix-cell {
    padding: 14px 8px;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    font-feature-settings: 'tnum';
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
  }
  .matrix-cell:disabled, .matrix-cell.zero {
    color: var(--text-4);
    cursor: default;
    background: transparent;
  }
  .matrix-cell.good:not(.zero):not(:disabled) { background: var(--good-bg); border-color: rgba(16, 185, 129, 0.2); color: var(--good); }
  .matrix-cell.fair:not(.zero):not(:disabled) { background: var(--fair-bg); border-color: rgba(245, 158, 11, 0.2); color: var(--fair); }
  .matrix-cell.poor:not(.zero):not(:disabled) { background: var(--poor-bg); border-color: rgba(239, 68, 68, 0.25); color: var(--poor); }
  .matrix-cell:not(.zero):not(:disabled):hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow);
    filter: brightness(1.02);
  }
  .matrix-cell.active {
    box-shadow: 0 0 0 2px var(--primary), var(--shadow);
  }
  .matrix-cell .cell-sub {
    display: block;
    font-size: 10px;
    font-weight: 500;
    color: inherit;
    opacity: 0.7;
    margin-top: 2px;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Filter banner */
  .filter-banner {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--primary-light);
    border: 1px solid rgba(59, 181, 232, 0.3);
    border-radius: 10px;
    margin-bottom: 12px;
    font-size: 12px;
    color: var(--primary-dark);
    font-weight: 500;
    animation: fadeUp 0.25s ease;
  }
  .filter-banner.show { display: flex; }
  .filter-banner .banner-icon { width: 14px; height: 14px; }
  .filter-banner .banner-clear {
    margin-left: auto;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--primary-dark);
    display: inline-flex; align-items: center; gap: 4px;
  }
  .filter-banner .banner-clear:hover { background: rgba(59, 181, 232, 0.15); }

  /* Quick actions */
  .quick-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .quick-action {
    display: flex; flex-direction: column; gap: 10px;
    padding: 18px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--card);
    text-align: left;
    transition: all 0.2s;
  }
  .quick-action:hover { border-color: var(--primary); background: var(--primary-soft); transform: translateY(-1px); }
  .quick-action .qa-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: var(--primary-light);
    color: var(--primary-dark);
    display: flex; align-items: center; justify-content: center;
  }
  .quick-action .qa-icon .icon { width: 18px; height: 18px; }
  .qa-title { font-size: 13px; font-weight: 700; color: var(--text); }
  .qa-sub { font-size: 11px; color: var(--text-3); line-height: 1.4; }

  /* Animations */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes barGrow {
    from { height: 0; opacity: 0; }
  }

  /* Utility */
  .hidden { display: none !important; }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 10px; border: 2px solid var(--bg); }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-4); }

  /* Pulse for notifications */
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .dot { animation: pulse 2s infinite; }

  /* Responsive */
  @media (max-width: 1200px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    .grid-2-1, .grid-1-1 { grid-template-columns: 1fr; }
    .heatmap { grid-template-columns: 80px repeat(4, 1fr); }
  }
  @media (max-width: 768px) {
    .sidebar { display: none; }
    .content { padding: 20px; }
    .topbar { padding: 16px 20px; gap: 10px; flex-wrap: wrap; }
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>

<script>
(function(){
  function decodeJwtPayload(token) {
    try {
      let payload = token.split('.')[1];
      payload = payload.replace(/-/g, '+').replace(/_/g, '/');
      while (payload.length % 4) payload += '=';
      return JSON.parse(atob(payload));
    } catch (e) {
      return null;
    }
  }

  const token = localStorage.getItem('jwt_token') || '';
  if (token) {
    const decoded = decodeJwtPayload(token) || {};
    const jwtLoginId = String(decoded.login_id || decoded.loginId || '').trim();
    if (jwtLoginId) {
      localStorage.setItem('login_id', jwtLoginId);
    }
    const displayName = String(decoded.username || decoded.name || '').trim();
    if (displayName) {
      localStorage.setItem('display_name', displayName);
    }
  }
})();
</script>

</head>
<body>

<div class="app">

  <!-- ================= SIDEBAR ================= -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-logo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
          <circle cx="12" cy="12" r="3" fill="currentColor"/>
        </svg>
      </div>
      <div class="brand-text">respyr</div>
      <div class="brand-pill">CLINIC</div>
    </div>

    <nav class="nav">
      <a class="nav-item active" href="#">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Dashboard
      </a>
      <span class="nav-item disabled">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg>
        Test history
      </span>
      <span class="nav-item disabled">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Subjects
      </span>
      <span class="nav-item disabled">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 12l4-4 4 4 6-6"/></svg>
        Reports
      </span>
      <span class="nav-item disabled">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </span>
    </nav>

    <div class="sidebar-footer">
      Designed by Humorstech Pvt Ltd<br/>
      v2.4.1
    </div>
  </aside>

  <!-- ================= MAIN ================= -->
  <main class="main">

    <!-- ========= TOPBAR ========= -->
    <header class="topbar">
      <!-- Smart Date Range Picker -->
      <div class="date-picker-wrap">
        <button class="date-picker-btn" id="dateBtn">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span><span id="dateRangeLabel">This Month</span> <span class="date-label-muted" id="dateRangeDates">· Apr 1 — 17, 2026</span></span>
          <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <div class="date-panel" id="datePanel">
          <div class="date-presets">
            <div class="preset-label">Quick Range</div>
            <button class="preset" data-range="today">Today</button>
            <button class="preset" data-range="yesterday">Yesterday</button>
            <button class="preset" data-range="this_week">This Week</button>
            <button class="preset" data-range="last_week">Last Week</button>
            <button class="preset active" data-range="this_month">This Month</button>
            <button class="preset" data-range="last_month">Last Month</button>
            <button class="preset" data-range="last_3_months">Last 3 Months</button>
            <button class="preset" data-range="this_year">This Year</button>
            <button class="preset" data-range="all_time">All Time</button>
            <button class="preset" data-range="custom">Custom Range</button>
          </div>
          <div class="date-custom">
            <div class="cal-head">
              <button class="cal-nav" id="calPrev">‹</button>
              <span id="calMonth">April 2026</span>
              <button class="cal-nav" id="calNext">›</button>
            </div>
            <div class="cal-grid" id="calGrid"></div>
          </div>
          <div class="date-apply-row">
            <button class="btn-sm btn-ghost" id="dateCancel">Cancel</button>
            <button class="btn-sm btn-primary" id="dateApply">Apply</button>
          </div>
        </div>
      </div>

      <!-- Search -->
      <div class="search">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input placeholder="Search patients, tests, or subject IDs..." />
      </div>

      <div class="topbar-right">
        <button class="icon-btn" title="Export">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>
        <button class="icon-btn" title="Notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="dot"></span>
        </button>
        <div class="profile">
          <div class="avatar" id="topAvatar">U</div>
          <div class="profile-info">
            <div class="profile-name" id="topProfileName">User</div>
            <div class="profile-role">Admin</div>
          </div>
        </div>
      </div>
    </header>

    <!-- ========= CONTENT ========= -->
    <div class="content">

      <div class="page-header">
        <div>
          <div class="page-title">Clinic Overview</div>
          <div class="page-sub">Summary of patient health tests and analytics for <span id="pageSubRange">this month</span>.</div>
        </div>
        <div class="page-actions">
          <button class="btn btn-outline">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
          <button class="btn btn-solid">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19V5"/></svg>
            New Patient
          </button>
        </div>
      </div>

      <!-- KPI ROW -->
      <section class="kpi-row">

        <div class="kpi clickable" id="kpiCardPatients">
          <div class="kpi-head">
            <div class="kpi-label">Total Patients</div>
            <div class="kpi-icon blue">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>
          <div class="kpi-value" id="kpiPatients">0</div>
          <div class="kpi-demographics" id="kpiDemographics"></div>
          <div class="kpi-foot" style="justify-content: space-between;">
            <span style="display:flex;align-items:center;gap:8px;">
              <span class="trend up">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                +2
              </span>
              <span>vs last month</span>
            </span>
            <span class="kpi-drill">
              View all
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </div>

        <div class="kpi clickable">
          <div class="kpi-head">
            <div class="kpi-label">Tests Taken</div>
            <div class="kpi-icon green">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
          </div>
          <div class="kpi-value" id="kpiTests">0<span class="unit">/0</span></div>
          <div class="kpi-progress"><div class="kpi-progress-bar" style="width: 3.4%"></div></div>
          <div class="kpi-foot" style="justify-content: space-between;">
            <span style="display:flex;align-items:center;gap:8px;">
              <span class="trend up">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                +23%
              </span>
              <span>0 remaining</span>
            </span>
            <span class="kpi-drill">
              History
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </div>

        <div class="kpi clickable">
          <div class="kpi-head">
            <div class="kpi-label">Avg Health Score</div>
            <div class="kpi-icon amber">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
          </div>
          <div class="kpi-value" id="kpiScore">0<span class="unit">%</span></div>
          <div class="kpi-concern" id="kpiConcern"></div>
          <div class="kpi-foot" style="justify-content: space-between;">
            <span style="display:flex;align-items:center;gap:8px;">
              <span class="trend up">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                +4%
              </span>
              <span>vs last month</span>
            </span>
            <span class="kpi-drill">
              Trends
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </div>

        <div class="kpi clickable" id="kpiCardSync">
          <div class="kpi-head">
            <div class="kpi-label">Last Sync</div>
            <div class="kpi-icon purple">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
            </div>
          </div>
          <div class="kpi-value" style="font-size: 26px;">NA<span class="unit"></span></div>
          <div class="kpi-sync-detail">
            <div class="sync-row">
              <span class="sync-dot" style="background: var(--good)"></span>
              <span><span class="sync-count">0 of 0</span> devices synced</span>
            </div>
            <div class="sync-row" style="color: var(--text-3);">
              <span class="sync-dot" style="background: var(--primary)"></span>
              <span>NA</span>
            </div>
          </div>
          <div class="kpi-foot" style="justify-content: space-between;">
            <span style="font-size: 11px; color: var(--good); font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              All active
            </span>
            <span class="kpi-drill">
              Details
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </div>

      </section>

      <!-- ROW 2 - MERGED Health Metrics Overview (full width, highest impact) -->
      <section style="margin-bottom: 24px;">
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Health Metrics Overview</div>
              <div class="card-sub">Click a band count or use filters to drill into specific patients</div>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
              <span style="font-size: 10px; color: var(--text-3); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;">Filter</span>
              <div class="dropdown">
                <button class="dropdown-btn" id="hmoParamBtn">
                  <span id="hmoParamLabel">All parameters</span>
                  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="dropdown-menu" id="hmoParamMenu">
                  <button class="dropdown-item active" data-param="all">All parameters</button>
                  <button class="dropdown-item" data-param="sugar">Sugar</button>
                  <button class="dropdown-item" data-param="liver">Liver</button>
                  <button class="dropdown-item" data-param="respiratory">Respiratory</button>
                  <button class="dropdown-item" data-param="gut">Gut</button>
                </div>
              </div>
              <div class="dropdown">
                <button class="dropdown-btn" id="hmoScoreBtn">
                  <span id="hmoScoreLabel">All scores</span>
                  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="dropdown-menu" id="hmoScoreMenu">
                  <button class="dropdown-item active" data-score="all">All scores</button>
                  <button class="dropdown-item" data-score="good">Good (≥80)</button>
                  <button class="dropdown-item" data-score="fair">Fair (65–79)</button>
                  <button class="dropdown-item" data-score="poor">Poor (&lt;65)</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Metric breakdown rows -->
          <div class="hmo-grid" id="hmoGrid"></div>

          <!-- Separator -->
          <div class="hmo-separator">
            <div class="hmo-separator-label" id="hmoListHeader">
              <span style="font-size: 13px; font-weight: 700; color: var(--text);">Matching Patients</span>
              <span id="hmoCount" style="font-size: 12px; color: var(--text-3); font-weight: 500; margin-left: 8px;">All 6 patients</span>
            </div>
            <button class="view-all-link" id="hmoViewAll">
              View all in Subjects
              <svg class="icon" style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>

          <!-- Filter banner -->
          <div class="filter-banner" id="filterBanner">
            <svg class="banner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span id="filterBannerText">Filtering patients</span>
            <button class="banner-clear" id="filterClear">
              Clear
              <svg style="width:12px;height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <div class="log-list" id="hmoPatientList"></div>
        </div>
      </section>

      <!-- ROW 3 - Volume Trend + Recent Tests -->
      <section class="grid-2-1">

        <!-- Test Volume -->
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Test Volume Trend</div>
              <div class="card-sub">Tests taken over the selected period</div>
            </div>
            <div class="dropdown">
              <button class="dropdown-btn" id="volumeGroupBtn">
                <span id="volumeGroupLabel">By Day</span>
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="dropdown-menu" id="volumeGroupMenu">
                <button class="dropdown-item active" data-group="day">By Day</button>
                <button class="dropdown-item" data-group="week">By Week</button>
                <button class="dropdown-item" data-group="month">By Month</button>
              </div>
            </div>
          </div>
          <div class="bar-wrap" id="volumeChart"></div>
        </div>

        <!-- Recent Tests -->
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Recent Tests</div>
              <div class="card-sub">Latest synced from devices</div>
            </div>
          </div>
          <div class="log-list" id="logList"></div>
        </div>

      </section>

      <!-- ROW 4 - Gender & Age Analytics + Admin Actions -->
      <section class="grid-2-1">

        <!-- Gender & Age Analytics -->
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Gender &amp; Age Analytics</div>
              <div class="card-sub">Avg score by demographic segment · Click a cell to see patients</div>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
              <div class="legend-badges">
                <span class="legend-badge"><span class="legend-dot good"></span>Good</span>
                <span class="legend-badge"><span class="legend-dot fair"></span>Fair</span>
                <span class="legend-badge"><span class="legend-dot poor"></span>Poor</span>
              </div>
              <div class="dropdown">
                <button class="dropdown-btn" id="hmMetricBtn">
                  <span id="hmMetricLabel">Overall</span>
                  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="dropdown-menu" id="hmMetricMenu">
                  <button class="dropdown-item active" data-metric="overall">Overall</button>
                  <button class="dropdown-item" data-metric="sugar">Sugar</button>
                  <button class="dropdown-item" data-metric="liver">Liver</button>
                  <button class="dropdown-item" data-metric="respiratory">Respiratory</button>
                  <button class="dropdown-item" data-metric="gut">Gut</button>
                </div>
              </div>
            </div>
          </div>

          <div class="heatmap" id="heatmap">
            <!-- filled by JS -->
          </div>

          <div class="segment-detail" id="segmentDetail">
            <!-- filled by JS based on selection -->
          </div>
        </div>

        <!-- Admin Actions -->
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Admin Actions</div>
              <div class="card-sub">Review &amp; report tools</div>
            </div>
          </div>
          <div class="admin-actions-col">
            <button class="admin-action">
              <div class="qa-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
              <div>
                <div class="qa-title">Export Clinic Report</div>
                <div class="qa-sub">PDF for selected period</div>
              </div>
              <svg class="aa-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button class="admin-action">
              <div class="qa-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><path d="M7 10l3 3 7-7"/></svg></div>
              <div>
                <div class="qa-title">Device Sync Status</div>
                <div class="qa-sub">3 devices · last 2h ago</div>
              </div>
              <svg class="aa-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button class="admin-action">
              <div class="qa-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
              <div>
                <div class="qa-title">Alert Thresholds</div>
                <div class="qa-sub">Set flag criteria</div>
              </div>
              <svg class="aa-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <button class="admin-action">
              <div class="qa-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></div>
              <div>
                <div class="qa-title">Invite Team Member</div>
