              </div>
              <svg class="aa-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

      </section>

    </div>
  </main>
</div>

<script>
/* ============== DATA ============== */
const patients = [
  { id: 'subject149',  name: 'Ishan Sinha',            gender: 'M', age: 28, tests: 9,  scores: { sugar: 71, liver: 76, respiratory: 83, gut: 78 }, lastTest: '2026-01-06 16:31' },
  { id: 'subject1141', name: 'Arun ji',                gender: 'M', age: 52, tests: 1,  scores: { sugar: 89, liver: 93, respiratory: 85, gut: 96 }, lastTest: '2026-01-06 13:41' },
  { id: 'subject1139', name: 'Dr Shriram',             gender: 'M', age: 61, tests: 1,  scores: { sugar: 77, liver: 82, respiratory: 100, gut: 86 }, lastTest: '2026-01-06 13:15' },
  { id: 'subject141',  name: 'Shashi Bhushan Mukesh',  gender: 'M', age: 58, tests: 21, scores: { sugar: 78, liver: 88, respiratory: 70, gut: 97 }, lastTest: '2025-11-28 09:10' },
  { id: 'subject142',  name: 'Nilu Bala Mukesh',       gender: 'F', age: 54, tests: 2,  scores: { sugar: 79.9, liver: 87.2, respiratory: 51, gut: 95.8 }, lastTest: '2025-09-11 08:27' },
  { id: 'subject539',  name: 'Priya Sharma',           gender: 'F', age: 34, tests: 3,  scores: { sugar: 85, liver: 90, respiratory: 88, gut: 82 }, lastTest: '2026-04-15 11:20' },
];

// Sample daily volume data for "This Month"
const volumeData = {
  day: [
    {label:'1', v:2},{label:'2', v:3},{label:'3', v:1},{label:'4', v:0},{label:'5', v:4},
    {label:'6', v:2},{label:'7', v:3},{label:'8', v:1},{label:'9', v:5},{label:'10', v:2},
    {label:'11', v:0},{label:'12', v:3},{label:'13', v:4},{label:'14', v:2},{label:'15', v:1},
    {label:'16', v:3},{label:'17', v:0}
  ],
  week: [
    {label:'W1', v:12},{label:'W2', v:15},{label:'W3', v:8},{label:'W4', v:0}
  ],
  month: [
    {label:'Nov', v:24},{label:'Dec', v:18},{label:'Jan', v:11},{label:'Feb', v:7},
    {label:'Mar', v:15},{label:'Apr', v:34}
  ]
};

const ageBuckets = ['18–30', '31–45', '46–60', '60+'];

function ageBucketIndex(age) {
  if (age <= 30) return 0;
  if (age <= 45) return 1;
  if (age <= 60) return 2;
  return 3;
}

// Compute avg scores by gender × age bucket × metric, directly from patient data
function computeSegments() {
  const segments = { F: [], M: [] };
  ['F', 'M'].forEach(g => {
    for (let i = 0; i < 4; i++) {
      segments[g][i] = { patients: [], avgByMetric: {}, overallAvg: null };
    }
  });
  patients.forEach(p => {
    const bi = ageBucketIndex(p.age);
    segments[p.gender][bi].patients.push(p);
  });
  ['F', 'M'].forEach(g => {
    segments[g].forEach(seg => {
      if (seg.patients.length === 0) return;
      ['sugar', 'liver', 'respiratory', 'gut'].forEach(m => {
        const sum = seg.patients.reduce((a, p) => a + p.scores[m], 0);
        seg.avgByMetric[m] = sum / seg.patients.length;
      });
      const all = seg.patients.flatMap(p => Object.values(p.scores));
      seg.overallAvg = all.reduce((a, v) => a + v, 0) / all.length;
    });
  });
  return segments;
}

/* ============== HELPERS ============== */
function qs(s, r=document) { return r.querySelector(s); }
function qsa(s, r=document) { return [...r.querySelectorAll(s)]; }

function scoreBand(v) {
  if (v >= 80) return 'good';
  if (v >= 65) return 'fair';
  return 'poor';
}

/* ============== RENDER: VOLUME CHART ============== */
let volumeGroup = 'day';
function renderVolumeChart() {
  const el = qs('#volumeChart');
  const data = volumeData[volumeGroup];
  const max = Math.max(...data.map(d => d.v), 5);
  // Round max up to nice number
  const niceMax = Math.ceil(max / 5) * 5 || 5;

  const gridLines = 4;
  let gridHtml = '<div class="bar-grid">';
  for (let i = 0; i <= gridLines; i++) {
    const val = Math.round(niceMax - (niceMax / gridLines) * i);
    gridHtml += `<div class="bar-grid-line"><div class="bar-grid-label">${val}</div></div>`;
  }
  gridHtml += '</div>';

  const isToday = (i) => volumeGroup === 'day' && i === data.length - 1;
  const todayIdx = data.length - 1;

  let barsHtml = '';
  data.forEach((d, i) => {
    const h = (d.v / niceMax) * 100;
    const active = volumeGroup !== 'day' || i !== todayIdx || d.v > 0;
    barsHtml += `
      <div class="bar ${d.v === 0 ? 'inactive' : ''}" style="height: ${Math.max(h, 1)}%; animation-delay: ${i * 30}ms">
        <div class="bar-tooltip">${d.v} test${d.v !== 1 ? 's' : ''} · ${volumeGroup === 'day' ? 'Apr ' + d.label : d.label}</div>
        <div class="bar-label">${d.label}</div>
      </div>
    `;
  });

  el.innerHTML = gridHtml + barsHtml;
}

/* ============== RENDER: HEALTH METRICS ============== */
const metricConfigs = [
  { key: 'sugar',       name: 'Sugar',       color: '#F59E0B', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>' },
  { key: 'liver',       name: 'Liver',       color: '#EF4444', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6 2 2 0 0 0-2-2h-1a.2.2 0 1 1 .2-.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/></svg>' },
  { key: 'respiratory', name: 'Respiratory', color: '#3BB5E8', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.081 20c3 0 5.919-1.6 5.919-4 0-2.4 2.92-4 5.92-4M12 20v-7M5 20h14"/></svg>' },
  { key: 'gut',         name: 'Gut',         color: '#10B981', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>' }
];
const metricByKey = Object.fromEntries(metricConfigs.map(m => [m.key, m]));

/* ============== FILTER STATE ============== */
// activeFilter = { parameter: 'all'|metric, score: 'all'|band }
let activeFilter = { parameter: 'all', score: 'all' };

/* ============== RENDER: HMO GRID (metric rows with clickable pills) ============== */
function renderHmoGrid() {
  const el = qs('#hmoGrid');
  el.innerHTML = metricConfigs.map(m => {
    const counts = { good: 0, fair: 0, poor: 0 };
    let sum = 0;
    patients.forEach(p => {
      const v = p.scores[m.key];
      counts[scoreBand(v)]++;
      sum += v;
    });
    const avg = sum / patients.length;
    const total = patients.length;
    const gPct = (counts.good / total) * 100;
    const fPct = (counts.fair / total) * 100;
    const pPct = (counts.poor / total) * 100;

    const isParamActive = activeFilter.parameter === m.key;
    return `
      <div class="hmo-row">
        <div class="hmo-metric-label">
          <div class="hmo-metric-icon" style="background:${m.color}22;color:${m.color}">${m.svg}</div>
          ${m.name}
        </div>
        <div class="hmo-avg">${avg.toFixed(0)}<span class="unit">%</span></div>
        <div class="hmo-dist" title="Good: ${counts.good} · Fair: ${counts.fair} · Poor: ${counts.poor}">
          ${counts.good > 0 ? `<div class="hmo-dist-seg good" style="width:${gPct}%"></div>` : ''}
          ${counts.fair > 0 ? `<div class="hmo-dist-seg fair" style="width:${fPct}%"></div>` : ''}
          ${counts.poor > 0 ? `<div class="hmo-dist-seg poor" style="width:${pPct}%"></div>` : ''}
        </div>
        <div class="hmo-pills">
          ${['good', 'fair', 'poor'].map(band => {
            const c = counts[band];
            const isActive = isParamActive && activeFilter.score === band;
            return `<button class="hmo-pill ${band}${c === 0 ? ' zero' : ''}${isActive ? ' active' : ''}"
                            data-param="${m.key}" data-score="${band}"
                            ${c === 0 ? 'disabled' : ''}>
                      ${c} ${band.charAt(0).toUpperCase() + band.slice(1)}
                    </button>`;
          }).join('')}
        </div>
      </div>
    `;
  }).join('');

  // Wire up pill clicks
  qsa('.hmo-pill:not(.zero)', el).forEach(pill => {
    pill.addEventListener('click', () => {
      const p = pill.dataset.param;
      const s = pill.dataset.score;
      if (activeFilter.parameter === p && activeFilter.score === s) {
        activeFilter = { parameter: 'all', score: 'all' };
      } else {
        activeFilter = { parameter: p, score: s };
      }
      syncFilterUI();
      renderHmoGrid();
      renderHmoList();
    });
  });
}

/* ============== RENDER: HMO PATIENT LIST ============== */
function renderHmoList() {
  const banner = qs('#filterBanner');
  const bannerText = qs('#filterBannerText');
  const listEl = qs('#hmoPatientList');
  const countEl = qs('#hmoCount');
  const headerEl = qs('#hmoListHeader').querySelector('span:first-child');

  let list = [...patients];
  let filtered = false;

  // Apply filters
  if (activeFilter.parameter !== 'all' && activeFilter.score !== 'all') {
    list = list.filter(p => scoreBand(p.scores[activeFilter.parameter]) === activeFilter.score);
    filtered = true;
  } else if (activeFilter.parameter !== 'all') {
    // Just parameter: sort by that metric worst-first
    list = [...list].sort((a, b) => a.scores[activeFilter.parameter] - b.scores[activeFilter.parameter]);
    filtered = true;
  } else if (activeFilter.score !== 'all') {
    // Just score band: patients who have ANY metric in that band
    list = list.filter(p => Object.values(p.scores).some(v => scoreBand(v) === activeFilter.score));
    filtered = true;
  }

  // Update banner + header
  if (filtered) {
    banner.classList.add('show');
    const parts = [];
    if (activeFilter.parameter !== 'all') {
      parts.push(`<strong>${metricByKey[activeFilter.parameter].name}</strong>`);
    }
    if (activeFilter.score !== 'all') {
      parts.push(`<strong>${activeFilter.score.charAt(0).toUpperCase() + activeFilter.score.slice(1)}</strong>`);
    }
    bannerText.innerHTML = `Filtering by ${parts.join(' · ')} — showing ${list.length} patient${list.length !== 1 ? 's' : ''}`;
    headerEl.textContent = 'Filtered Patients';
    countEl.textContent = `${list.length} of ${patients.length}`;
  } else {
    banner.classList.remove('show');
    // Default: sort by lowest score (attention-needed first)
    list = [...list].sort((a, b) => Math.min(...Object.values(a.scores)) - Math.min(...Object.values(b.scores)));
    headerEl.textContent = 'All Patients';
    countEl.textContent = `${patients.length} total, sorted by lowest score`;
  }

  if (list.length === 0) {
    listEl.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--text-3);font-size:13px;">No patients match this filter ✨</div>';
    return;
  }

  listEl.innerHTML = list.slice(0, 5).map(p => {
    const scoresArr = Object.entries(p.scores);
    return `
      <div class="log-row" style="cursor:pointer;">
        <div>
          <div class="log-name">${p.name}</div>
          <div class="log-meta">${p.id} · ${p.age}y ${p.gender === 'M' ? 'Male' : 'Female'} · ${p.tests} test${p.tests !== 1 ? 's' : ''}</div>
        </div>
        <div class="log-scores">
          <span class="score-pill ${scoreBand(p.scores.sugar)}">S ${Math.round(p.scores.sugar)}</span>
          <span class="score-pill ${scoreBand(p.scores.liver)}">L ${Math.round(p.scores.liver)}</span>
          <span class="score-pill ${scoreBand(p.scores.respiratory)}">R ${Math.round(p.scores.respiratory)}</span>
          <span class="score-pill ${scoreBand(p.scores.gut)}">G ${Math.round(p.scores.gut)}</span>
        </div>
        <div class="log-time">${formatDate(p.lastTest)}</div>
      </div>
    `;
  }).join('');
}

/* Keep dropdown labels in sync with activeFilter */
function syncFilterUI() {
  const paramLabel = activeFilter.parameter === 'all' ? 'All parameters' : metricByKey[activeFilter.parameter].name;
  qs('#hmoParamLabel').textContent = paramLabel;
  const scoreLabel = activeFilter.score === 'all' ? 'All scores' :
    activeFilter.score === 'good' ? 'Good (≥80)' :
    activeFilter.score === 'fair' ? 'Fair (65–79)' : 'Poor (<65)';
  qs('#hmoScoreLabel').textContent = scoreLabel;
  // Update active dropdown items
  qsa('#hmoParamMenu .dropdown-item').forEach(i => i.classList.toggle('active', i.dataset.param === activeFilter.parameter));
  qsa('#hmoScoreMenu .dropdown-item').forEach(i => i.classList.toggle('active', i.dataset.score === activeFilter.score));
}

/* ============== RENDER: LOG ============== */
function renderLog() {
  const sorted = [...patients].sort((a, b) => new Date(b.lastTest) - new Date(a.lastTest)).slice(0, 5);
  const el = qs('#logList');
  el.innerHTML = sorted.map(p => {
    return `
      <div class="log-row">
        <div>
          <div class="log-name">${p.name}</div>
          <div class="log-meta">${p.id} · ${formatDate(p.lastTest)}</div>
        </div>
        <div class="log-scores">
          <span class="score-pill ${scoreBand(p.scores.sugar)}">S ${Math.round(p.scores.sugar)}</span>
          <span class="score-pill ${scoreBand(p.scores.liver)}">L ${Math.round(p.scores.liver)}</span>
          <span class="score-pill ${scoreBand(p.scores.respiratory)}">R ${Math.round(p.scores.respiratory)}</span>
          <span class="score-pill ${scoreBand(p.scores.gut)}">G ${Math.round(p.scores.gut)}</span>
        </div>
      </div>
    `;
  }).join('');
}
function formatDate(s) {
  const d = new Date(s);
  const now = new Date();
  const diff = Math.floor((now - d) / (1000 * 60 * 60 * 24));
  if (diff === 0) return 'Today';
  if (diff === 1) return 'Yesterday';
  if (diff < 7) return `${diff}d ago`;
  if (diff < 30) return `${Math.floor(diff / 7)}w ago`;
  return d.toLocaleDateString('en', { month: 'short', day: 'numeric' });
}

/* ============== RENDER: KPI CARD 1 - DEMOGRAPHICS ============== */
function renderDemographics() {
  const male = patients.filter(p => p.gender === 'M').length;
  const female = patients.filter(p => p.gender === 'F').length;
  const total = patients.length;
  const mPct = total ? Math.round((male / total) * 100) : 0;
  const fPct = total ? Math.round((female / total) * 100) : 0;

  qs('#kpiDemographics').innerHTML = `
    <span class="demo-item">
      <span class="demo-icon male">♂</span>
      <span class="demo-count">${male}</span>
      <span>Male</span>
      <span class="demo-pct">${mPct}%</span>
    </span>
    <span class="demo-item">
      <span class="demo-icon female">♀</span>
      <span class="demo-count">${female}</span>
      <span>Female</span>
      <span class="demo-pct">${fPct}%</span>
    </span>
  `;
}

/* ============== RENDER: KPI CARD 3 - CONCERN DISTRIBUTION ============== */
function renderConcernDistribution() {
  // Classify each patient by highest severity across their scores:
  //   - "Serious"  = has ≥1 Poor score
  //   - "Mild"     = has no Poor, but ≥1 Fair
  //   - "Healthy"  = all Good
  const tiers = { healthy: 0, mild: 0, serious: 0 };
  patients.forEach(p => {
    const bands = Object.values(p.scores).map(scoreBand);
    if (bands.includes('poor')) tiers.serious++;
    else if (bands.includes('fair')) tiers.mild++;
    else tiers.healthy++;
  });
  const total = patients.length;
  const pct = (n) => total ? Math.round((n / total) * 100) : 0;

  qs('#kpiConcern').innerHTML = `
    <div class="kpi-concern-bar">
      ${tiers.healthy > 0 ? `<div class="kpi-concern-seg good" style="width:${(tiers.healthy/total)*100}%"></div>` : ''}
      ${tiers.mild > 0 ? `<div class="kpi-concern-seg fair" style="width:${(tiers.mild/total)*100}%"></div>` : ''}
      ${tiers.serious > 0 ? `<div class="kpi-concern-seg poor" style="width:${(tiers.serious/total)*100}%"></div>` : ''}
    </div>
    <div class="kpi-concern-legend">
      <div class="row">
        <span class="cdot" style="background:var(--good)"></span>
        <span class="num">${tiers.healthy}</span>
        <span>Good</span>
        <span class="pct">${pct(tiers.healthy)}%</span>
      </div>
      <div class="row">
        <span class="cdot" style="background:var(--fair)"></span>
        <span class="num">${tiers.mild}</span>
        <span>Fair</span>
        <span class="pct">${pct(tiers.mild)}%</span>
      </div>
      <div class="row">
        <span class="cdot" style="background:var(--poor)"></span>
        <span class="num">${tiers.serious}</span>
        <span>Poor</span>
        <span class="pct">${pct(tiers.serious)}%</span>
      </div>
    </div>
  `;
}

/* ============== RENDER: KPI CARD 4 - LAST SYNC (static for mockup) ============== */
// Sync info is static in this mockup — in production it would read from device/sync state.

/* ============== RENDER: HEATMAP (3-color, real data, clickable) ============== */
let heatmapMetric = 'overall';
let selectedCell = null; // { gender, bucketIdx }

function renderHeatmap() {
  const el = qs('#heatmap');
  const segments = computeSegments();

  let html = '<div></div>';
  ageBuckets.forEach(b => html += `<div class="heatmap-head">${b}</div>`);

  const genders = [
    { key: 'F', label: 'Female', icon: '♀', bg: '#FCE7F3', fg: '#BE185D' },
    { key: 'M', label: 'Male', icon: '♂', bg: '#DBEAFE', fg: '#1E40AF' }
  ];

  genders.forEach(g => {
    html += `<div class="heatmap-row-head">
      <span style="display:inline-flex;width:20px;height:20px;border-radius:50%;align-items:center;justify-content:center;background:${g.bg};color:${g.fg};margin-right:8px;font-size:12px;font-weight:700;">${g.icon}</span>
      ${g.label}
    </div>`;
    segments[g.key].forEach((seg, i) => {
      if (seg.patients.length === 0) {
        html += `<div class="heatmap-cell empty" data-gender="${g.key}" data-bucket="${i}">
          <div class="val">—</div>
          <div class="cnt">No data</div>
        </div>`;
      } else {
        const v = heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[heatmapMetric];
        const band = scoreBand(v);
        const isSelected = selectedCell && selectedCell.gender === g.key && selectedCell.bucketIdx === i;
        html += `<div class="heatmap-cell ${band}${isSelected ? ' active' : ''}" data-gender="${g.key}" data-bucket="${i}" title="${g.label} · ${ageBuckets[i]} · ${v.toFixed(0)}%">
          <div class="val">${v.toFixed(0)}</div>
          <div class="cnt">${seg.patients.length} patient${seg.patients.length !== 1 ? 's' : ''}</div>
        </div>`;
      }
    });
  });

  el.innerHTML = html;

  // Click handlers on non-empty cells
  qsa('.heatmap-cell:not(.empty)', el).forEach(cell => {
    cell.addEventListener('click', () => {
      const g = cell.dataset.gender;
      const b = parseInt(cell.dataset.bucket);
      if (selectedCell && selectedCell.gender === g && selectedCell.bucketIdx === b) {
        selectedCell = null;
      } else {
        selectedCell = { gender: g, bucketIdx: b };
      }
      renderHeatmap();
      renderSegmentDetail();
    });
  });
}

/* ============== RENDER: SEGMENT DETAIL (below heatmap) ============== */
function renderSegmentDetail() {
  const el = qs('#segmentDetail');
  const segments = computeSegments();

  if (!selectedCell) {
    // Default: best/worst callouts
    let best = null, worst = null;
    ['F', 'M'].forEach(g => {
      segments[g].forEach((seg, i) => {
        if (seg.patients.length === 0) return;
        const v = heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[heatmapMetric];
        const label = `${g === 'F' ? 'Female' : 'Male'}, ${ageBuckets[i]}`;
        if (!best || v > best.v) best = { v, label };
        if (!worst || v < worst.v) worst = { v, label };
      });
    });
    el.innerHTML = `
      <div class="segment-default">
        <div class="segment-callout">
          <div class="label">Best segment</div>
          <div class="value" style="color:var(--good)">${best ? best.label + ' · ' + best.v.toFixed(0) + '%' : '—'}</div>
        </div>
        <div class="segment-callout worst">
          <div class="label">Needs attention</div>
          <div class="value">${worst ? worst.label + ' · ' + worst.v.toFixed(0) + '%' : '—'}</div>
        </div>
        <div style="align-self: center; font-size: 11px; color: var(--text-3); font-style: italic;">
          Click any cell above to see patients
        </div>
      </div>
    `;
    return;
  }

  const seg = segments[selectedCell.gender][selectedCell.bucketIdx];
  const v = heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[heatmapMetric];
  const genderLabel = selectedCell.gender === 'F' ? 'Female' : 'Male';
  const bandColor = scoreBand(v);

  el.innerHTML = `
    <div class="segment-selected">
      <div class="seg-head">
        <div>
          <div class="seg-title">${genderLabel}, ${ageBuckets[selectedCell.bucketIdx]} · <span style="color:var(--${bandColor === 'good' ? 'good' : bandColor === 'fair' ? 'fair' : 'poor'});">${v.toFixed(0)}%</span> ${heatmapMetric === 'overall' ? 'overall' : heatmapMetric}</div>
          <div class="seg-sub">${seg.patients.length} patient${seg.patients.length !== 1 ? 's' : ''} in this segment</div>
        </div>
        <button class="view-all-link" onclick="alert('Would navigate to Subjects filtered by this segment')">
          View all in Subjects
          <svg class="icon" style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
      <div>
        ${seg.patients.map(p => {
          const avg = Object.values(p.scores).reduce((a,v)=>a+v,0) / 4;
          const band = scoreBand(avg);
          const initial = p.name.split(' ').map(w => w[0]).slice(0, 2).join('');
          return `
            <div class="segment-patient">
              <div class="sp-avatar">${initial}</div>
              <div class="sp-name">${p.name} <span style="color:var(--text-3); font-weight: 400; font-size: 11px; margin-left: 4px;">· ${p.age}y · ${p.id}</span></div>
              <span class="sp-score ${band}">${avg.toFixed(0)}%</span>
            </div>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

/* ============== FILTER CONTROLS (dropdowns + clear) ============== */
qs('#filterClear').addEventListener('click', () => {
  activeFilter = { parameter: 'all', score: 'all' };
  syncFilterUI();
  renderHmoGrid();
  renderHmoList();
});

qs('#hmoParamBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  qs('#hmoParamMenu').classList.toggle('open');
});
qsa('#hmoParamMenu .dropdown-item').forEach(item => {
  item.addEventListener('click', () => {
    activeFilter.parameter = item.dataset.param;
    syncFilterUI();
    qs('#hmoParamMenu').classList.remove('open');
    renderHmoGrid();
    renderHmoList();
  });
});

qs('#hmoScoreBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  qs('#hmoScoreMenu').classList.toggle('open');
});
qsa('#hmoScoreMenu .dropdown-item').forEach(item => {
  item.addEventListener('click', () => {
    activeFilter.score = item.dataset.score;
    syncFilterUI();
    qs('#hmoScoreMenu').classList.remove('open');
    renderHmoGrid();
    renderHmoList();
  });
});

// View all link in HMO
qs('#hmoViewAll').addEventListener('click', () => {
  alert('Would navigate to Subjects' + (activeFilter.parameter !== 'all' || activeFilter.score !== 'all' ? ' with this filter applied' : ''));
});

// Patients KPI card click → scroll to HMO
qs('#kpiCardPatients').addEventListener('click', () => {
  qs('#hmoGrid').scrollIntoView({ behavior: 'smooth', block: 'center' });
});

/* ============== DATE PICKER ============== */
const today = new Date('2026-04-17');
let calMonth = today.getMonth();
let calYear = today.getFullYear();
let rangeStart = new Date('2026-04-01');
let rangeEnd = new Date('2026-04-17');
let pendingRange = null;

function renderCalendar() {
  const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  qs('#calMonth').textContent = `${monthNames[calMonth]} ${calYear}`;

  const firstDay = new Date(calYear, calMonth, 1);
  const lastDay = new Date(calYear, calMonth + 1, 0);
  const startDow = firstDay.getDay();

  const grid = qs('#calGrid');
  let html = '';
  ['Su','Mo','Tu','We','Th','Fr','Sa'].forEach(d => html += `<div class="dow">${d}</div>`);

  const prevLast = new Date(calYear, calMonth, 0).getDate();
  for (let i = startDow - 1; i >= 0; i--) {
    html += `<div class="cal-day other">${prevLast - i}</div>`;
  }
  for (let d = 1; d <= lastDay.getDate(); d++) {
    const date = new Date(calYear, calMonth, d);
    const isToday = date.toDateString() === today.toDateString();
    const inRange = rangeStart && rangeEnd && date >= rangeStart && date <= rangeEnd;
    const isStart = rangeStart && date.toDateString() === rangeStart.toDateString();
    const isEnd = rangeEnd && date.toDateString() === rangeEnd.toDateString();
    let cls = 'cal-day';
    if (isToday) cls += ' today';
    if (inRange) cls += ' in-range';
    if (isStart) cls += ' range-start';
    if (isEnd) cls += ' range-end';
    html += `<div class="${cls}" data-date="${date.toISOString()}">${d}</div>`;
  }
  const totalCells = startDow + lastDay.getDate();
  const remaining = (7 - (totalCells % 7)) % 7;
  for (let d = 1; d <= remaining; d++) {
    html += `<div class="cal-day other">${d}</div>`;
  }
  grid.innerHTML = html;

  // Click handlers
grid.innerHTML = html;

qsa('#calGrid .cal-day[data-date]').forEach(dayEl => {
  dayEl.addEventListener('click', () => {
    const clickedDate = new Date(dayEl.dataset.date);

    rangeStart = clickedDate;
    rangeEnd = clickedDate;
    pendingRange = { start: clickedDate, end: clickedDate };

    renderCalendar();

    selectedFormattedDate = [
      String(clickedDate.getDate()).padStart(2, '0'),
      String(clickedDate.getMonth() + 1).padStart(2, '0'),
      clickedDate.getFullYear()
    ].join('/');

    updateDateLabel('Custom');
    qs('#datePanel').classList.remove('open');
    refreshDashboardData();
  });
});
}

function applyPreset(range) {
  const t = new Date(today);
  let s, e, label;
  switch (range) {
    case 'today':        s = new Date(t); e = new Date(t); label = 'Today'; break;
    case 'yesterday':    s = new Date(t); s.setDate(s.getDate() - 1); e = new Date(s); label = 'Yesterday'; break;
    case 'this_week':    s = new Date(t); s.setDate(s.getDate() - s.getDay()); e = new Date(t); label = 'This Week'; break;
    case 'last_week':    e = new Date(t); e.setDate(e.getDate() - e.getDay() - 1); s = new Date(e); s.setDate(s.getDate() - 6); label = 'Last Week'; break;
    case 'this_month':   s = new Date(t.getFullYear(), t.getMonth(), 1); e = new Date(t); label = 'This Month'; break;
    case 'last_month':   s = new Date(t.getFullYear(), t.getMonth()-1, 1); e = new Date(t.getFullYear(), t.getMonth(), 0); label = 'Last Month'; break;
    case 'last_3_months':s = new Date(t.getFullYear(), t.getMonth()-3, 1); e = new Date(t); label = 'Last 3 Months'; break;
    case 'this_year':    s = new Date(t.getFullYear(), 0, 1); e = new Date(t); label = 'This Year'; break;
    case 'all_time':     s = new Date('2025-01-01'); e = new Date(t); label = 'All Time'; break;
    case 'custom':       return; // handled by calendar
  }
  rangeStart = s; rangeEnd = e;
  updateDateLabel(label);
  renderCalendar();
}

function updateDateLabel(label) {
  qs('#dateRangeLabel').textContent = label;
  const fmt = (d) => d.toLocaleDateString('en', { month: 'short', day: 'numeric' });
  const yr = rangeEnd.getFullYear();
  const same = rangeStart.toDateString() === rangeEnd.toDateString();
  qs('#dateRangeDates').textContent = same
    ? `· ${fmt(rangeStart)}, ${yr}`
    : `· ${fmt(rangeStart)} — ${fmt(rangeEnd)}, ${yr}`;
  qs('#pageSubRange').textContent = label.toLowerCase();
}

// Date picker events
qs('#dateBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  qs('#datePanel').classList.toggle('open');
});
qsa('.preset').forEach(p => {
  p.addEventListener('click', () => {
    qsa('.preset').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    if (p.dataset.range !== 'custom') {
      applyPreset(p.dataset.range);
    }
  });
});
qs('#calPrev').addEventListener('click', () => {
  calMonth--;
  if (calMonth < 0) { calMonth = 11; calYear--; }
  renderCalendar();
});
qs('#calNext').addEventListener('click', () => {
  calMonth++;
  if (calMonth > 11) { calMonth = 0; calYear++; }
  renderCalendar();
});
qs('#dateAppl').addEventListener('click', () => {
  const active = qs('.preset.active');
  if (active) {
    if (active.dataset.range === 'custom') updateDateLabel('Custom Range');
    else applyPreset(active.dataset.range);
  }
  qs('#datePanel').classList.remove('open');
  // Re-render (in real app, would filter data)
  renderVolumeChart();
});
qs('#dateCancel').addEventListener('click', () => {
  qs('#datePanel').classList.remove('open');
});

document.addEventListener('click', (e) => {
  if (!qs('#datePanel').contains(e.target) && !qs('#dateBtn').contains(e.target)) {
    qs('#datePanel').classList.remove('open');
  }
  // Close dropdowns
  qsa('.dropdown-menu').forEach(m => {
    if (!m.parentElement.contains(e.target)) m.classList.remove('open');
  });
});

/* ============== DROPDOWNS ============== */
// Volume grouping
qs('#volumeGroupBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  qs('#volumeGroupMenu').classList.toggle('open');
});
qsa('#volumeGroupMenu .dropdown-item').forEach(item => {
  item.addEventListener('click', () => {
    qsa('#volumeGroupMenu .dropdown-item').forEach(x => x.classList.remove('active'));
    item.classList.add('active');
    volumeGroup = item.dataset.group;
    qs('#volumeGroupLabel').textContent = item.textContent;
    qs('#volumeGroupMenu').classList.remove('open');
    renderVolumeChart();
  });
});

// Heatmap metric
qs('#hmMetricBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  qs('#hmMetricMenu').classList.toggle('open');
});
qsa('#hmMetricMenu .dropdown-item').forEach(item => {
  item.addEventListener('click', () => {
    qsa('#hmMetricMenu .dropdown-item').forEach(x => x.classList.remove('active'));
    item.classList.add('active');
    heatmapMetric = item.dataset.metric;
    qs('#hmMetricLabel').textContent = item.textContent;
    qs('#hmMetricMenu').classList.remove('open');
    renderHeatmap();
    renderSegmentDetail();
  });
});

/* ============== INIT ============== */
renderCalendar();
syncFilterUI();
updateDateLabel('This Month');
</script>


<script>
(function(){
  const API = {
    analytics: 'https://humorstech.com/api/opd-encry-age-gender-diversity-v2.php',
    onboarded: 'https://humorstech.com/api/opd-onboard-pat_v2.php',
    allowance: 'https://humorstech.com/api/encrp_testallow_v2.php',
    reports: '../clinical-v2/data-reports.php'
  };

  const state = {
    loginId: '',
    token: '',
    selectedDate: '',
    analyticsRows: [],
    reportRows: [],
    onboarded: 0,
    allowance: null,
    volumeGroup: 'day',
    heatmapMetric: 'overall',
    selectedCell: null,
    hmoParam: 'all',
    hmoScore: 'all'
  };
  let selectedFormattedDate = '';

  const ageBuckets = [
    { label: '18–24 yrs', min: 18, max: 24 },
    { label: '25–32 yrs', min: 25, max: 32 },
    { label: '33–40 yrs', min: 33, max: 40 },
    { label: '41–50 yrs', min: 41, max: 50 },
    { label: '50+ yrs', min: 51, max: 200 }
  ];

  function qs(sel, root=document){ return root.querySelector(sel); }
  function qsa(sel, root=document){ return Array.from(root.querySelectorAll(sel)); }
  function escapeHtml(v){ return String(v ?? '').replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s])); }

  function decodeJwtPayload(token) {
    try {
      let payload = token.split('.')[1];
      payload = payload.replace(/-/g, '+').replace(/_/g, '/');
      while (payload.length % 4) payload += '=';
      return JSON.parse(atob(payload));
    } catch (e) {
      return null;
    }
  }

  function getLoginId() {
    const token = localStorage.getItem('jwt_token');
    const stored = (localStorage.getItem('login_id') || '').trim();

    let jwtLoginId = '';
    if (token) {
      const decoded = decodeJwtPayload(token) || {};
      jwtLoginId = String(decoded.login_id || decoded.loginId || '').trim();
    }

    // Prefer the real login_id from JWT whenever available.
    // The old dashboard sometimes stores username in localStorage.login_id,
    // which breaks APIs expecting the actual login_id.
    if (jwtLoginId) {
      if (stored !== jwtLoginId) {
        localStorage.setItem('login_id', jwtLoginId);
      }
      return jwtLoginId;
    }

    return stored;
  }

  function getSelectedDate() {
    const d = (typeof rangeEnd !== 'undefined' && rangeEnd instanceof Date) ? rangeEnd : new Date();
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yyyy = d.getFullYear();
    return `${dd}/${mm}/${yyyy}`;
  }

  async function fetchForm(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(body)
    });
    if (!res.ok) throw new Error(`Request failed: ${res.status}`);
    return res.json();
  }

  async function fetchJson(url, options={}) {
    const res = await fetch(url, options);
    if (!res.ok) throw new Error(`Request failed: ${res.status}`);
    return res.json();
  }

  function scoreBand(score) {
    const n = Number(score) || 0;
    if (n >= 80) return 'good';
    if (n >= 70) return 'fair';
    return 'poor';
  }

  function normalizeGender(value) {
    const g = String(value || '').trim().toLowerCase();
    if (g.startsWith('m')) return 'M';
    if (g.startsWith('f')) return 'F';
    return '';
  }

  function parseDateTime(dttm) {
    if (!dttm) return null;
    const [datePart, timePart='00:00'] = String(dttm).split(' ');
    const bits = datePart.split('/');
    if (bits.length === 3) {
      const [month, day, year] = bits;
      const iso = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}T${timePart.length===5?timePart+':00':timePart}`;
      const d = new Date(iso);
      return isNaN(d) ? null : d;
    }
    const d = new Date(dttm);
    return isNaN(d) ? null : d;
  }

  function formatRecentDate(value) {
    const d = value instanceof Date ? value : parseDateTime(value);
    if (!d) return '—';
    const now = new Date();
    const sameDay = d.toDateString() === now.toDateString();
    if (sameDay) return 'Today';
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    if (d.toDateString() === yesterday.toDateString()) return 'Yesterday';
    return d.toLocaleString('en', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function calcOverall(row) {
    const vals = ['Db_Score', 'liver_score', 'Blow_Score', 'Gut_Score_per']
      .map(k => Number(row[k]))
      .filter(v => !Number.isNaN(v));
    if (!vals.length) return 0;
    return vals.reduce((a,b)=>a+b,0) / vals.length;
  }

  function normalizePatient(row) {
    const dt = parseDateTime(row.dttm);
    return {
      raw: row,
      id: row.profile_id || row.id || Math.random().toString(36).slice(2),
      name: row.name || 'Unknown',
      gender: normalizeGender(row.gender),
      age: Number(row.age) || null,
      dateObj: dt,
      dateText: formatRecentDate(dt),
      scores: {
        sugar: Number(row.Db_Score) || 0,
        liver: Number(row.liver_score) || 0,
        respiratory: Number(row.Blow_Score) || 0,
        gut: Number(row.Gut_Score_per) || 0,
        overall: calcOverall(row)
      },
      meta: {
        acetone: row.acetone_ppm,
        ethanol: row.ethnol_ppm,
        hydrogen: row.h2_ppm,
        respiratory: row.respiratory_fvc_json
      }
    };
  }

  function getPatients() {
    return (state.analyticsRows || []).map(normalizePatient);
  }

  function computeDemographics(patients) {
    const male = patients.filter(p => p.gender === 'M').length;
    const female = patients.filter(p => p.gender === 'F').length;
    const total = male + female;
    return {
      male,
      female,
      malePct: total ? Math.round((male / total) * 100) : 0,
      femalePct: total ? Math.round((female / total) * 100) : 0,
      total: patients.length
    };
  }

  function clearDashboardForNoData() {
    const patientsEl = qs('#kpiPatients');
    if (patientsEl) patientsEl.textContent = '—';

    const testsEl = qs('#kpiTests');
    if (testsEl) testsEl.innerHTML = `—<span class="unit">/—</span>`;

    const progressBar = qs('.kpi-row .kpi:nth-child(2) .kpi-progress-bar');
    if (progressBar) progressBar.style.width = '0%';

    const scoreEl = qs('#kpiScore');
    if (scoreEl) scoreEl.innerHTML = `—<span class="unit">%</span>`;

    const demoEl = qs('#kpiDemographics');
    if (demoEl) demoEl.innerHTML = '';

    const concernEl = qs('#kpiConcern');
    if (concernEl) concernEl.innerHTML = '';

    const logEl = qs('#testLogBody') || qs('#employeeTable');
    if (logEl) {
      if (logEl.tagName === 'TBODY') {
        logEl.innerHTML = `<tr><td colspan="3" style="text-align:center;color:var(--text-3);padding:18px 12px;">No data found</td></tr>`;
      } else {
        logEl.innerHTML = `<tr><td colspan="2" style="text-align:center;color:var(--text-3);padding:18px 12px;">No data found</td></tr>`;
      }
    }

    const segmentEl = qs('#segmentDetail');
    if (segmentEl) segmentEl.innerHTML = `<div class="segment-default"><div class="segment-callout"><div class="label">Status</div><div class="value">No data found</div></div></div>`;

    const hmoGrid = qs('#hmoGrid');
    if (hmoGrid) hmoGrid.innerHTML = `<div style="padding:12px 0;color:var(--text-3);">No data found</div>`;

    const hmoList = qs('#hmoList');
    if (hmoList) hmoList.innerHTML = `<div style="padding:12px 0;color:var(--text-3);">No data found</div>`;

    const heatmap = qs('#heatmap');
    if (heatmap) heatmap.innerHTML = `<div style="grid-column:1/-1;padding:12px 0;color:var(--text-3);">No data found</div>`;

    const volumeWrap = qs('#volumeBars');
    if (volumeWrap) volumeWrap.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;min-height:180px;color:var(--text-3);font-size:12px;">No data found</div>`;
  }

  function renderKpis() {
    const patients = getPatients();
    const demo = computeDemographics(patients);
    const totalPatients = Number(state.onboarded) || patients.length;
    const avg = patients.length ? Math.round(patients.reduce((s,p)=>s+p.scores.overall,0) / patients.length) : 0;

    const tiers = { healthy: 0, mild: 0, serious: 0 };
    patients.forEach(p => {
      const bands = [p.scores.sugar, p.scores.liver, p.scores.respiratory, p.scores.gut].map(scoreBand);
      if (bands.includes('poor')) tiers.serious++;
      else if (bands.includes('fair')) tiers.mild++;
      else tiers.healthy++;
    });
    const pct = (n) => patients.length ? Math.round((n / patients.length) * 100) : 0;

    const patientsEl = qs('#kpiPatients');
    if (patientsEl) patientsEl.textContent = totalPatients;

    const testsEl = qs('#kpiTests');
    const progressBar = qs('.kpi-row .kpi:nth-child(2) .kpi-progress-bar');
    if (testsEl) {
      const completed = Number(state.allowance?.clinical_score_count || 0);
      const allowed = Number(state.allowance?.test_no || 0);
      testsEl.innerHTML = `${completed}<span class="unit">/${allowed || 0}</span>`;
      if (progressBar) {
        const percent = allowed ? Math.max(0, Math.min(100, (completed / allowed) * 100)) : 0;
        progressBar.style.width = `${percent}%`;
      }
    }

    const scoreEl = qs('#kpiScore');
    if (scoreEl) scoreEl.innerHTML = `${avg}<span class="unit">%</span>`;

    const demoEl = qs('#kpiDemographics');
    if (demoEl) {
      demoEl.innerHTML = `
        <span class="demo-item">
          <span class="demo-icon male">♂</span>
          <span class="demo-count">${demo.male}</span>
          <span>Male</span>
          <span class="demo-pct">${demo.malePct}%</span>
        </span>
        <span class="demo-item">
          <span class="demo-icon female">♀</span>
          <span class="demo-count">${demo.female}</span>
          <span>Female</span>
          <span class="demo-pct">${demo.femalePct}%</span>
        </span>
      `;
    }

    const concernEl = qs('#kpiConcern');
    if (concernEl) {
      concernEl.innerHTML = `
        <div class="kpi-concern-bar">
          ${tiers.healthy ? `<div class="kpi-concern-seg good" style="width:${(tiers.healthy / Math.max(patients.length,1))*100}%"></div>` : ''}
          ${tiers.mild ? `<div class="kpi-concern-seg fair" style="width:${(tiers.mild / Math.max(patients.length,1))*100}%"></div>` : ''}
          ${tiers.serious ? `<div class="kpi-concern-seg poor" style="width:${(tiers.serious / Math.max(patients.length,1))*100}%"></div>` : ''}
        </div>
        <div class="kpi-concern-legend">
          <div class="row"><span class="cdot" style="background:var(--good)"></span><span>Healthy</span><span class="num">${tiers.healthy}</span><span class="pct">${pct(tiers.healthy)}%</span></div>
          <div class="row"><span class="cdot" style="background:var(--fair)"></span><span>Mild concern</span><span class="num">${tiers.mild}</span><span class="pct">${pct(tiers.mild)}%</span></div>
          <div class="row"><span class="cdot" style="background:var(--poor)"></span><span>Needs attention</span><span class="num">${tiers.serious}</span><span class="pct">${pct(tiers.serious)}%</span></div>
        </div>
      `;
    }
  }

  function groupReportRows() {
    const rows = Array.isArray(state.reportRows) ? state.reportRows : [];
    const buckets = new Map();
    rows.forEach(item => {
      if (!item || !item.timestamp) return;
      const d = new Date(Number(item.timestamp) * 1000);
      if (isNaN(d)) return;
      let key, label, sortValue;
      if (state.volumeGroup === 'week') {
        const start = new Date(d);
        const day = start.getDay();
        start.setDate(start.getDate() - day);
        key = start.toISOString().slice(0,10);
        label = start.toLocaleDateString('en', { month: 'short', day: 'numeric' });
        sortValue = start.getTime();
      } else if (state.volumeGroup === 'month') {
        key = `${d.getFullYear()}-${d.getMonth()+1}`;
        label = d.toLocaleDateString('en', { month: 'short' });
        sortValue = new Date(d.getFullYear(), d.getMonth(), 1).getTime();
      } else {
        key = d.toISOString().slice(0,10);
        label = d.toLocaleDateString('en', { month: 'short', day: 'numeric' });
        sortValue = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      }
      const rec = buckets.get(key) || { label, v: 0, sortValue };
      rec.v += 1;
      buckets.set(key, rec);
    });
    return Array.from(buckets.values()).sort((a,b) => a.sortValue - b.sortValue);
  }

  function renderVolumeChart() {
    const el = qs('#volumeChart');
    if (!el) return;
    const data = groupReportRows();
    if (!data.length) {
      el.innerHTML = '<div style="padding:32px 0;color:var(--text-3);font-size:13px;">No test volume data found.</div>';
      return;
    }
    const max = Math.max(...data.map(d => d.v), 1);
    const grid = [0, 25, 50, 75, 100];
    el.innerHTML = `
      <div class="bar-grid">
        ${grid.map(g => `<div class="bar-grid-line"><span class="bar-grid-label">${Math.round((max*g)/100)}</span></div>`).join('')}
      </div>
      ${data.map(d => {
        const h = Math.max(8, (d.v / max) * 100);
        return `<div class="bar" style="height:${h}%">
          <div class="bar-tooltip">${d.v} test${d.v !== 1 ? 's' : ''}</div>
          <div class="bar-label">${escapeHtml(d.label)}</div>
        </div>`;
      }).join('')}
    `;
  }

  function hmoMetricValue(patient, metric) {
    if (metric === 'all' || metric === 'overall') return patient.scores.overall;
    if (metric === 'sugar') return patient.scores.sugar;
    if (metric === 'liver') return patient.scores.liver;
    if (metric === 'respiratory') return patient.scores.respiratory;
    if (metric === 'gut') return patient.scores.gut;
    return patient.scores.overall;
  }

  function filterPatientsForHmo(patients) {
    return patients.filter(p => {
      const value = hmoMetricValue(p, state.hmoParam);
      if (state.hmoScore === 'all') return true;
      return scoreBand(value) === state.hmoScore;
    });
  }

  function renderHmoGrid() {
    const grid = qs('#hmoGrid');
    if (!grid) return;
    const patients = getPatients();
    const metrics = [
      { key: 'sugar', label: 'Sugar' },
      { key: 'liver', label: 'Liver' },
      { key: 'respiratory', label: 'Respiratory' },
      { key: 'gut', label: 'Gut' }
    ];
    grid.innerHTML = metrics.map(metric => {
      const values = patients.map(p => p.scores[metric.key]).filter(v => !Number.isNaN(v));
      const avg = values.length ? Math.round(values.reduce((a,b)=>a+b,0) / values.length) : 0;
      const good = values.filter(v => scoreBand(v) === 'good').length;
      const fair = values.filter(v => scoreBand(v) === 'fair').length;
      const poor = values.filter(v => scoreBand(v) === 'poor').length;
      const total = Math.max(values.length, 1);
      return `
        <div class="hmo-row">
          <div class="hmo-metric-label">${metric.label}</div>
          <div class="hmo-avg">${avg}<span class="unit">%</span></div>
          <div class="hmo-dist">
            <div class="hmo-dist-seg good" style="width:${(good/total)*100}%"></div>
            <div class="hmo-dist-seg fair" style="width:${(fair/total)*100}%"></div>
            <div class="hmo-dist-seg poor" style="width:${(poor/total)*100}%"></div>
          </div>
          <div class="hmo-pills">
            <button class="hmo-pill good ${good===0?'zero':''}" data-param="${metric.key}" data-score="good"><span class="pdot"></span>${good}</button>
            <button class="hmo-pill fair ${fair===0?'zero':''}" data-param="${metric.key}" data-score="fair"><span class="pdot"></span>${fair}</button>
            <button class="hmo-pill poor ${poor===0?'zero':''}" data-param="${metric.key}" data-score="poor"><span class="pdot"></span>${poor}</button>
          </div>
        </div>
      `;
    }).join('');

    qsa('.hmo-pill:not(.zero)', grid).forEach(btn => {
      btn.addEventListener('click', () => {
        state.hmoParam = btn.dataset.param;
        state.hmoScore = btn.dataset.score;
        const paramLabels = { all: 'All parameters', sugar: 'Sugar', liver: 'Liver', respiratory: 'Respiratory', gut: 'Gut' };
        const scoreLabels = { all: 'All scores', good: 'Good (≥80)', fair: 'Fair (70–79)', poor: 'Poor (<70)' };
        if (qs('#hmoParamLabel')) qs('#hmoParamLabel').textContent = paramLabels[state.hmoParam];
        if (qs('#hmoScoreLabel')) qs('#hmoScoreLabel').textContent = scoreLabels[state.hmoScore];
        syncFilterUI();
        renderHmoList();
      });
    });
  }

  function renderHmoList() {
    const list = qs('#hmoPatientList');
    const count = qs('#hmoCount');
    const banner = qs('#filterBanner');
    const bannerText = qs('#filterBannerText');
    if (!list) return;
    const filtered = filterPatientsForHmo(getPatients()).sort((a,b) => (b.dateObj?.getTime()||0) - (a.dateObj?.getTime()||0));
    if (count) count.textContent = `${filtered.length} patient${filtered.length !== 1 ? 's' : ''}`;
    if (banner && bannerText) {
      const active = state.hmoParam !== 'all' || state.hmoScore !== 'all';
      banner.classList.toggle('show', active);
      bannerText.textContent = active ? `Filtering ${state.hmoParam === 'all' ? 'all parameters' : state.hmoParam} · ${state.hmoScore}` : '';
    }
    if (!filtered.length) {
      list.innerHTML = '<div style="padding:12px 0;color:var(--text-3);font-size:13px;">NA</div>';
      return;
    }
    list.innerHTML = filtered.map(p => `
      <div class="log-row">
        <div>
          <div class="log-name">${escapeHtml(p.name)}</div>
          <div class="log-meta">${p.gender === 'M' ? 'Male' : p.gender === 'F' ? 'Female' : '—'} · ${p.age ?? '—'} yrs · ${escapeHtml(p.dateText)}</div>
        </div>
        <div class="log-scores">
          <span class="score-pill ${scoreBand(p.scores.sugar)}">S ${Math.round(p.scores.sugar)}</span>
          <span class="score-pill ${scoreBand(p.scores.liver)}">L ${Math.round(p.scores.liver)}</span>
          <span class="score-pill ${scoreBand(p.scores.respiratory)}">R ${Math.round(p.scores.respiratory)}</span>
          <span class="score-pill ${scoreBand(p.scores.gut)}">G ${Math.round(p.scores.gut)}</span>
        </div>
        <div class="log-time">${escapeHtml(p.raw.profile_id || '')}</div>
      </div>
    `).join('');
  }

  function syncFilterUI() {
    qsa('#hmoParamMenu .dropdown-item').forEach(item => item.classList.toggle('active', item.dataset.param === state.hmoParam));
    qsa('#hmoScoreMenu .dropdown-item').forEach(item => item.classList.toggle('active', item.dataset.score === state.hmoScore));
  }

  function renderLog() {
    const el = qs('#logList');
    if (!el) return;
    const patients = getPatients().sort((a,b) => (b.dateObj?.getTime()||0) - (a.dateObj?.getTime()||0)).slice(0, 5);
    if (!patients.length) {
      el.innerHTML = '<div style="padding:12px 0;color:var(--text-3);font-size:13px;">NA</div>';
      return;
    }
    el.innerHTML = patients.map(p => `
      <div class="log-row">
        <div>
          <div class="log-name">${escapeHtml(p.name)}</div>
          <div class="log-meta">${p.gender === 'M' ? 'Male' : p.gender === 'F' ? 'Female' : '—'} · ${p.age ?? '—'} yrs</div>
        </div>
        <div class="log-scores">
          <span class="score-pill ${scoreBand(p.scores.sugar)}">S ${Math.round(p.scores.sugar)}</span>
          <span class="score-pill ${scoreBand(p.scores.liver)}">L ${Math.round(p.scores.liver)}</span>
          <span class="score-pill ${scoreBand(p.scores.respiratory)}">R ${Math.round(p.scores.respiratory)}</span>
          <span class="score-pill ${scoreBand(p.scores.gut)}">G ${Math.round(p.scores.gut)}</span>
        </div>
        <div class="log-time">${escapeHtml(p.dateText)}</div>
      </div>
    `).join('');
  }

  function computeSegments() {
    const segments = { F: ageBuckets.map(()=>({ patients: [] })), M: ageBuckets.map(()=>({ patients: [] })) };
    getPatients().forEach(p => {
      if (!p.gender || p.age == null) return;
      const idx = ageBuckets.findIndex(b => p.age >= b.min && p.age <= b.max);
      if (idx === -1 || !segments[p.gender]) return;
      segments[p.gender][idx].patients.push(p);
    });
    ['F','M'].forEach(g => {
      segments[g] = segments[g].map(seg => {
        const values = seg.patients.map(p => ({
          overall: p.scores.overall,
          sugar: p.scores.sugar,
          liver: p.scores.liver,
          respiratory: p.scores.respiratory,
          gut: p.scores.gut
        }));
        const avgByMetric = {};
        ['overall','sugar','liver','respiratory','gut'].forEach(metric => {
          const nums = values.map(v => v[metric]).filter(v => !Number.isNaN(v));
          avgByMetric[metric] = nums.length ? nums.reduce((a,b)=>a+b,0) / nums.length : 0;
        });
        return { patients: seg.patients, overallAvg: avgByMetric.overall, avgByMetric };
      });
    });
    return segments;
  }

  function renderHeatmap() {
    const el = qs('#heatmap');
    if (!el) return;
    const segments = computeSegments();
    const genders = [
      { key: 'F', label: 'Female', icon: '♀', bg: '#FCE7F3', fg: '#BE185D' },
      { key: 'M', label: 'Male', icon: '♂', bg: '#DBEAFE', fg: '#1E40AF' }
    ];
    let html = '<div></div>' + ageBuckets.map(b => `<div class="heatmap-head">${b.label}</div>`).join('');
    genders.forEach(g => {
      html += `<div class="heatmap-row-head"><span style="display:inline-flex;width:20px;height:20px;border-radius:50%;align-items:center;justify-content:center;background:${g.bg};color:${g.fg};margin-right:8px;font-size:12px;font-weight:700;">${g.icon}</span>${g.label}</div>`;
      segments[g.key].forEach((seg, i) => {
        if (!seg.patients.length) {
          html += `<div class="heatmap-cell empty" data-gender="${g.key}" data-bucket="${i}"><div class="val">—</div><div class="cnt">No data</div></div>`;
        } else {
          const val = state.heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[state.heatmapMetric];
          const band = scoreBand(val);
          const active = state.selectedCell && state.selectedCell.gender === g.key && state.selectedCell.bucketIdx === i;
          html += `<div class="heatmap-cell ${band}${active ? ' active' : ''}" data-gender="${g.key}" data-bucket="${i}">
            <div class="val">${Math.round(val)}</div>
            <div class="cnt">${seg.patients.length} patient${seg.patients.length !== 1 ? 's' : ''}</div>
          </div>`;
        }
      });
    });
    el.innerHTML = html;
    qsa('.heatmap-cell:not(.empty)', el).forEach(cell => {
      cell.addEventListener('click', () => {
        const g = cell.dataset.gender;
        const b = Number(cell.dataset.bucket);
        if (state.selectedCell && state.selectedCell.gender === g && state.selectedCell.bucketIdx === b) state.selectedCell = null;
        else state.selectedCell = { gender: g, bucketIdx: b };
        renderHeatmap();
        renderSegmentDetail();
      });
    });
  }

  function resetNoDataState() {
    state.analyticsRows = [];
    state.reportRows = [];
    state.onboarded = 0;
    state.allowance = null;
    state.selectedCell = null;
    renderKpis();
    renderVolumeChart();
    renderHeatmap();
    renderSegmentDetail();
    renderLog();
    renderDemographics();
    renderConcernDistribution();
    renderHmoGrid();
    renderHmoList();
    syncFilterUI();
  }

  function renderSegmentDetail() {
    const el = qs('#segmentDetail');
    if (!el) return;
    const segments = computeSegments();
    if (!state.selectedCell) {
      let best = null, worst = null;
      ['F','M'].forEach(g => {
        segments[g].forEach((seg, i) => {
          if (!seg.patients.length) return;
          const v = state.heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[state.heatmapMetric];
          const label = `${g === 'F' ? 'Female' : 'Male'}, ${ageBuckets[i].label}`;
          if (!best || v > best.v) best = { v, label };
          if (!worst || v < worst.v) worst = { v, label };
        });
      });
      el.innerHTML = `
        <div class="segment-default">
          <div class="segment-callout">
            <div class="label">Best segment</div>
            <div class="value" style="color:var(--good)">${best ? `${best.label} · ${best.v.toFixed(0)}%` : '—'}</div>
          </div>
          <div class="segment-callout worst">
            <div class="label">Needs attention</div>
            <div class="value">${worst ? `${worst.label} · ${worst.v.toFixed(0)}%` : '—'}</div>
          </div>
        </div>`;
      return;
    }
    const seg = segments[state.selectedCell.gender][state.selectedCell.bucketIdx];
    const val = state.heatmapMetric === 'overall' ? seg.overallAvg : seg.avgByMetric[state.heatmapMetric];
    const genderLabel = state.selectedCell.gender === 'F' ? 'Female' : 'Male';
    const metricLabel = state.heatmapMetric === 'overall' ? 'overall' : state.heatmapMetric;
    el.innerHTML = `
      <div class="segment-selected">
        <div class="seg-head">
          <div>
            <div class="seg-title">${genderLabel}, ${ageBuckets[state.selectedCell.bucketIdx].label} · <span style="color:var(--${scoreBand(val) === 'good' ? 'good' : scoreBand(val) === 'fair' ? 'fair' : 'poor'});">${val.toFixed(0)}%</span> ${metricLabel}</div>
            <div class="seg-sub">${seg.patients.length} patient${seg.patients.length !== 1 ? 's' : ''} in this segment</div>
          </div>
        </div>
        ${seg.patients.sort((a,b) => hmoMetricValue(b, state.heatmapMetric) - hmoMetricValue(a, state.heatmapMetric)).slice(0,5).map(p => `
          <div class="segment-patient">
            <div class="sp-avatar">${escapeHtml((p.name||'U').charAt(0).toUpperCase())}</div>
            <div class="sp-name">${escapeHtml(p.name)}</div>
            <div class="sp-score ${scoreBand(hmoMetricValue(p, state.heatmapMetric))}">${Math.round(hmoMetricValue(p, state.heatmapMetric))}%</div>
          </div>`).join('')}
      </div>`;
  }

  async function refreshDashboardData() {
    state.loginId = getLoginId();
    state.token = localStorage.getItem('jwt_token') || '';
    state.selectedDate = getSelectedDate();
    if (!state.loginId) {
      console.warn('login_id not found in localStorage/JWT');
      resetNoDataState();
      return;
    }
    console.log('Dashboard login_id:', state.loginId, 'selectedDate:', state.selectedDate);
    const displayName = (localStorage.getItem('display_name') || localStorage.getItem('username') || 'User').trim();
    const avatarChar = displayName ? displayName.charAt(0).toUpperCase() : 'U';
    const nameEl = document.getElementById('topProfileName');
    const avatarEl = document.getElementById('topAvatar');
    if (nameEl) nameEl.textContent = displayName;
    if (avatarEl) avatarEl.textContent = avatarChar;

    const requests = [
      fetchForm(API.analytics, { login_id: state.loginId, date: state.selectedDate }).catch(() => []),
      fetchForm(API.onboarded, { login_id: state.loginId }).catch(() => ({ onboarded: 0 })),
      fetchJson(`${API.allowance}?login_id=${encodeURIComponent(state.loginId)}`).catch(() => null)
    ];

    if (state.token) {
      requests.push(fetchJson(API.reports, { headers: { Authorization: 'Bearer ' + state.token } }).catch(() => []));
    } else {
      requests.push(Promise.resolve([]));
    }

    const [analytics, onboarded, allowance, reports] = await Promise.all(requests);
    state.analyticsRows = Array.isArray(analytics) ? analytics : [];
    state.onboarded = Number(onboarded?.onboarded || 0);
    state.allowance = allowance || null;
    state.reportRows = Array.isArray(reports) ? reports : [];

    const hasAnalytics = state.analyticsRows.length > 0;
    const hasReports = state.reportRows.length > 0;
    const hasAllowance = !!state.allowance;
    const hasOnboarded = Number.isFinite(state.onboarded) && state.onboarded > 0;

    if (!hasAnalytics && !hasReports && !hasAllowance && !hasOnboarded) {
      clearDashboardForNoData();
      return;
    }

    renderKpis();
    renderVolumeChart();
    renderLog();
    renderHeatmap();
    renderSegmentDetail();
    renderHmoGrid();
    renderHmoList();
  }

  function bindControls() {
    const volumeBtn = qs('#volumeGroupBtn');
    const volumeMenu = qs('#volumeGroupMenu');
    if (volumeBtn && volumeMenu) {
      volumeBtn.onclick = (e) => { e.stopPropagation(); volumeMenu.classList.toggle('open'); };
      qsa('.dropdown-item', volumeMenu).forEach(item => {
        item.onclick = () => {
          qsa('.dropdown-item', volumeMenu).forEach(x => x.classList.remove('active'));
          item.classList.add('active');
          state.volumeGroup = item.dataset.group;
          qs('#volumeGroupLabel').textContent = item.textContent;
          volumeMenu.classList.remove('open');
          renderVolumeChart();
        };
      });
    }

    const hmBtn = qs('#hmMetricBtn');
    const hmMenu = qs('#hmMetricMenu');
    if (hmBtn && hmMenu) {
      hmBtn.onclick = (e) => { e.stopPropagation(); hmMenu.classList.toggle('open'); };
      qsa('.dropdown-item', hmMenu).forEach(item => {
        item.onclick = () => {
          qsa('.dropdown-item', hmMenu).forEach(x => x.classList.remove('active'));
          item.classList.add('active');
          state.heatmapMetric = item.dataset.metric;
          qs('#hmMetricLabel').textContent = item.textContent;
          hmMenu.classList.remove('open');
          state.selectedCell = null;
          renderHeatmap();
          renderSegmentDetail();
        };
      });
    }

    const hmoParamBtn = qs('#hmoParamBtn');
    const hmoParamMenu = qs('#hmoParamMenu');
    if (hmoParamBtn && hmoParamMenu) {
      hmoParamBtn.onclick = (e) => { e.stopPropagation(); hmoParamMenu.classList.toggle('open'); };
      qsa('.dropdown-item', hmoParamMenu).forEach(item => {
        item.onclick = () => {
          state.hmoParam = item.dataset.param;
          qs('#hmoParamLabel').textContent = item.textContent;
          syncFilterUI();
          hmoParamMenu.classList.remove('open');
          renderHmoList();
        };
      });
    }

    const hmoScoreBtn = qs('#hmoScoreBtn');
    const hmoScoreMenu = qs('#hmoScoreMenu');
    if (hmoScoreBtn && hmoScoreMenu) {
      hmoScoreBtn.onclick = (e) => { e.stopPropagation(); hmoScoreMenu.classList.toggle('open'); };
      qsa('.dropdown-item', hmoScoreMenu).forEach(item => {
        item.onclick = () => {
          state.hmoScore = item.dataset.score;
          qs('#hmoScoreLabel').textContent = item.textContent;
          syncFilterUI();
          hmoScoreMenu.classList.remove('open');
          renderHmoList();
        };
      });
    }

    const clearBtn = qs('#filterClear');
    if (clearBtn) {
      clearBtn.onclick = () => {
        state.hmoParam = 'all';
        state.hmoScore = 'all';
        if (qs('#hmoParamLabel')) qs('#hmoParamLabel').textContent = 'All parameters';
        if (qs('#hmoScoreLabel')) qs('#hmoScoreLabel').textContent = 'All scores';
        syncFilterUI();
        renderHmoList();
      };
    }

    const dateApply = qs('#dateApply');
    if (dateApply) {
      dateApply.addEventListener('click', () => {
        setTimeout(refreshDashboardData, 0);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    bindControls();
    setTimeout(refreshDashboardData, 0);
  });
})();
</script>

</body>
</html>
