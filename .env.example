# Required. Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Set this in Amplify Console → Hosting → Environment variables before deploying.
SESSION_SECRET=

# Optional overrides — defaults point at the production PHP backend.
# RESPYR_API_BASE=https://humorstech.com/api
# RESPYR_CLINIC_BASE=https://humorstech.com/humors_app/app_final/clinical
# RESPYR_API_TIMEOUT_MS=15000

# For local development against fabricated data (npm run dev:fixtures):
# RESPYR_API_BASE=http://localhost:3005
