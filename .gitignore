# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── PHP dashboard (the currently live product) ───
# Now safe to publish: every credential was moved out of these folders in
# Oct 2026 (backend logic ported to dashboard-backend/, retired files with
# hardcoded secrets stay local in _unused/, which is never committed).
/_unused/

# macOS
**/.DS_Store
